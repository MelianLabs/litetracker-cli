cmd_version() {
  echo "lt version $VERSION"
}

# --- Main Router ---

main() {
  check_deps

  local cmd="${1:-help}"
  shift || true

  case "$cmd" in
    auth)     cmd_auth "$@" ;;
    me)       load_token; cmd_me "$@" ;;
    projects) load_token; cmd_projects "$@" ;;
    stories)  load_token; cmd_stories "$@" ;;
    story)
      load_token
      local action="${1:-help}"
      shift || true
      case "$action" in
        show)    cmd_story_show "$@" ;;
        create)  cmd_story_create "$@" ;;
        update)  cmd_story_update "$@" ;;
        label)   cmd_story_label "$@" ;;
        comments) cmd_story_comments "$@" ;;
        comment)  cmd_story_comment "$@" ;;
        *)        die "Unknown story action: $action. Use: show, create, update, label, comments, comment" ;;
      esac
      ;;
    schema)   cmd_schema "$@" ;;
    cache)
      local action="${1:-help}"
      shift || true
      case "$action" in
        sync)    load_token; cmd_cache_sync "$@" ;;
        stories) cmd_cache_stories "$@" ;;
        stats)   cmd_cache_stats "$@" ;;
        clear)   cmd_cache_clear "$@" ;;
        *)       die "Unknown cache action: $action. Use: sync, stories, stats, clear" ;;
      esac
      ;;
    help|-h|--help) cmd_help ;;
    version|--version|-v) cmd_version ;;
    *) die "Unknown command: $cmd. Run 'lt help' for usage." ;;
  esac
}

main "$@"
