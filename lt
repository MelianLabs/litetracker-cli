#!/usr/bin/env bash
set -euo pipefail

VERSION="0.1.0"
BASE_URL="https://app.litetracker.com/services/v5"
CONFIG_DIR="$HOME/.lt"
TOKEN_FILE="$CONFIG_DIR/api_token"

# --- Helpers ---

die() {
  echo "Error: $1" >&2
  exit 1
}

check_deps() {
  command -v curl >/dev/null 2>&1 || die "curl is required. Install it with: sudo apt install curl"
  command -v jq >/dev/null 2>&1 || die "jq is required. Install it with: sudo apt install jq"
}

check_cache_deps() {
  command -v sqlite3 >/dev/null 2>&1 || die "sqlite3 is required for cache commands. Install it with: sudo apt install sqlite3"
}

load_token() {
  [[ -f "$TOKEN_FILE" ]] || die "Not authenticated. Run 'lt auth' first."
  TOKEN=$(<"$TOKEN_FILE")
  [[ -n "$TOKEN" ]] || die "API token is empty. Run 'lt auth' to reconfigure."
}

api_get() {
  local url="$BASE_URL$1"
  local max_attempts="${LT_API_MAX_ATTEMPTS:-5}" attempt=1 sleep_s=1
  local response http_code body curl_rc

  while :; do
    if response=$(curl -sS -w "\n%{http_code}" -H "X-TrackerToken: $TOKEN" "$url" 2>&1); then
      curl_rc=0
      http_code=$(echo "$response" | tail -1)
      body=$(echo "$response" | sed '$d')
    else
      curl_rc=$?
      http_code=0
      body="$response"
    fi

    # Success or non-retryable 4xx — return / die immediately.
    if [[ "$curl_rc" -eq 0 && "$http_code" -lt 500 ]]; then
      if [[ "$http_code" -ge 400 ]]; then
        die "API error ($http_code): $body"
      fi
      echo "$body"
      return 0
    fi

    if [[ "$attempt" -ge "$max_attempts" ]]; then
      if [[ "$curl_rc" -ne 0 ]]; then
        die "curl failed after $max_attempts attempts (rc=$curl_rc): $body"
      else
        die "API error ($http_code) after $max_attempts attempts: $body"
      fi
    fi

    if [[ "$curl_rc" -ne 0 ]]; then
      echo "Warning: curl failed (rc=$curl_rc), retrying in ${sleep_s}s (attempt $attempt/$max_attempts)" >&2
    else
      echo "Warning: API returned $http_code, retrying in ${sleep_s}s (attempt $attempt/$max_attempts)" >&2
    fi
    sleep "$sleep_s"
    sleep_s=$((sleep_s * 2))
    attempt=$((attempt + 1))
  done
}

api_post() {
  local response http_code body
  response=$(curl -sS -w "\n%{http_code}" \
    -X POST \
    -H "X-TrackerToken: $TOKEN" \
    -H "Content-Type: application/json" \
    -d "$2" \
    "$BASE_URL$1")
  http_code=$(echo "$response" | tail -1)
  body=$(echo "$response" | sed '$d')
  if [[ "$http_code" -ge 400 ]]; then
    die "API error ($http_code): $body"
  fi
  echo "$body"
}

api_put() {
  local response http_code body
  response=$(curl -sS -w "\n%{http_code}" \
    -X PUT \
    -H "X-TrackerToken: $TOKEN" \
    -H "Content-Type: application/json" \
    -d "$2" \
    "$BASE_URL$1")
  http_code=$(echo "$response" | tail -1)
  body=$(echo "$response" | sed '$d')
  if [[ "$http_code" -ge 400 ]]; then
    die "API error ($http_code): $body"
  fi
  echo "$body"
}

# --- Cache (local SQLite mirror) ---
#
# Layout: $CACHE_DIR is created lazily. All projects live in one DB.
# Schema is embedded inline below so the install stays a single file.

CACHE_DIR="$CONFIG_DIR/cache"
CACHE_DB="$CACHE_DIR/litetracker.db"

cache_schema_sql() {
  cat <<'SQL'
PRAGMA foreign_keys = ON;
PRAGMA journal_mode = WAL;

CREATE TABLE IF NOT EXISTS projects (
  id             INTEGER PRIMARY KEY,
  title          TEXT,
  data           TEXT,
  last_synced_at TEXT
);

CREATE TABLE IF NOT EXISTS stories (
  id                     INTEGER PRIMARY KEY,
  project_id             INTEGER NOT NULL REFERENCES projects(id),
  title                  TEXT,
  story_type             TEXT,
  current_state          TEXT,
  estimate               INTEGER,
  url                    TEXT,
  created_at             TEXT,
  updated_at             TEXT,
  accepted_at            TEXT,
  description            TEXT,
  -- These two cache the value of `updated_at` that was current when we last
  -- fetched the description / comments. Compare with `=` to decide re-fetch
  -- (LT returns `updated_at` as a free-form string, not ISO, so ordering
  -- comparisons are unreliable across formats).
  description_updated_at TEXT,
  comments_updated_at    TEXT,
  data                   TEXT,
  cached_at              TEXT
);
CREATE INDEX IF NOT EXISTS idx_stories_project ON stories(project_id);
CREATE INDEX IF NOT EXISTS idx_stories_state   ON stories(current_state);
CREATE INDEX IF NOT EXISTS idx_stories_type    ON stories(story_type);
CREATE INDEX IF NOT EXISTS idx_stories_updated ON stories(updated_at);

CREATE TABLE IF NOT EXISTS story_labels (
  story_id INTEGER NOT NULL REFERENCES stories(id) ON DELETE CASCADE,
  label    TEXT    NOT NULL,
  PRIMARY KEY (story_id, label)
);
CREATE INDEX IF NOT EXISTS idx_story_labels_label ON story_labels(label);

CREATE TABLE IF NOT EXISTS story_owners (
  story_id INTEGER NOT NULL REFERENCES stories(id) ON DELETE CASCADE,
  owner_id INTEGER NOT NULL,
  PRIMARY KEY (story_id, owner_id)
);

CREATE TABLE IF NOT EXISTS comments (
  id         INTEGER PRIMARY KEY,
  story_id   INTEGER NOT NULL REFERENCES stories(id) ON DELETE CASCADE,
  text       TEXT,
  person_id  INTEGER,
  created_at TEXT,
  updated_at TEXT,
  data       TEXT
);
CREATE INDEX IF NOT EXISTS idx_comments_story ON comments(story_id);

CREATE TABLE IF NOT EXISTS sync_log (
  id                   INTEGER PRIMARY KEY AUTOINCREMENT,
  project_id           INTEGER NOT NULL,
  started_at           TEXT,
  finished_at          TEXT,
  pages_fetched        INTEGER,
  stories_inserted     INTEGER,
  stories_updated      INTEGER,
  stories_unchanged    INTEGER,
  comments_fetched     INTEGER,
  descriptions_fetched INTEGER,
  status               TEXT,
  error                TEXT
);
CREATE INDEX IF NOT EXISTS idx_sync_log_project ON sync_log(project_id);
SQL
}

cache_init() {
  check_cache_deps
  mkdir -p "$CACHE_DIR"
  # PRAGMA journal_mode prints "wal" to stdout — swallow it.
  cache_schema_sql | sqlite3 "$CACHE_DB" >/dev/null
}

cache_db() {
  sqlite3 -bail "$CACHE_DB" "$@"
}

# Validate that an argument is a non-negative integer; die otherwise.
require_int() {
  [[ "$1" =~ ^[0-9]+$ ]] || die "$2: expected integer, got '$1'"
}

# --- Commands ---

cmd_auth() {
  echo "Enter your LiteTracker API token."
  echo "You can find it at: https://app.litetracker.com/edit"
  echo ""
  read -rp "API Token: " token
  [[ -n "$token" ]] || die "Token cannot be empty."

  mkdir -p "$CONFIG_DIR"
  echo "$token" > "$TOKEN_FILE"
  chmod 600 "$TOKEN_FILE"

  # Verify token works
  TOKEN="$token"
  local me
  me=$(api_get "/me") || die "Token verification failed. Check your token and try again."
  local name
  name=$(echo "$me" | jq -r '.name // "Unknown"')
  echo "Authenticated as: $name"
  echo "Token saved to $TOKEN_FILE"
}

cmd_me() {
  local data
  data=$(api_get "/me")
  echo "$data" | jq '{
    id,
    name,
    initials,
    username,
    email,
    accounts: [.accounts[] | {name, status, plan}],
    projects: [.projects[] | {project_id, project_name, role}]
  }'
}

cmd_projects() {
  local data
  data=$(api_get "/projects")
  (
    echo -e "ID\tTITLE"
    echo "$data" | jq -r '.[] | [(.id|tostring), .title] | @tsv'
  ) | column -ts $'\t'
}

cmd_stories() {
  local project_id="${1:?Usage: lt stories <project_id> [--all] [--state STATE] [--limit N] [--offset N]}"
  shift || true

  local fetch_all=0
  local state=""
  local limit=""
  local offset=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --all) fetch_all=1; shift ;;
      --state) state="${2:?--state requires a value}"; shift 2 ;;
      --limit) limit="${2:?--limit requires a value}"; shift 2 ;;
      --offset) offset="${2:?--offset requires a value}"; shift 2 ;;
      *) die "Unknown flag: $1" ;;
    esac
  done

  local base_path="/projects/$project_id/stories"
  local all_data="[]"
  local page_size=50

  if [[ "$fetch_all" -eq 1 ]]; then
    local cur_offset=0
    local page count
    while :; do
      page=$(api_get "${base_path}?offset=${cur_offset}&limit=${page_size}")
      count=$(echo "$page" | jq 'length')
      all_data=$(jq -s 'add' <(echo "$all_data") <(echo "$page"))
      [[ "$count" -lt "$page_size" ]] && break
      cur_offset=$((cur_offset + page_size))
    done
  else
    local single_qs=""
    [[ -n "$offset" ]] && single_qs="${single_qs}&offset=${offset}"
    [[ -n "$limit" ]] && single_qs="${single_qs}&limit=${limit}"
    single_qs="${single_qs#&}"
    [[ -n "$single_qs" ]] && single_qs="?${single_qs}"
    all_data=$(api_get "${base_path}${single_qs}")
  fi

  # Client-side state filter (API ignores state query param)
  if [[ -n "$state" ]]; then
    all_data=$(echo "$all_data" | jq --arg s "$state" '[.[] | select(.current_state == $s)]')
  fi

  local total
  total=$(echo "$all_data" | jq 'length')
  (
    echo -e "ID\tTYPE\tSTATE\tTITLE"
    echo "$all_data" | jq -r '.[] | [(.id|tostring), .story_type, .current_state, .title] | @tsv'
  ) | column -ts $'\t'

  if [[ "$fetch_all" -eq 0 && "$total" -eq "$page_size" ]]; then
    echo >&2
    echo "Note: returned exactly $page_size rows — more may exist. Re-run with --all to fetch every page." >&2
  fi
}

cmd_story_show() {
  local project_id="${1:?Usage: lt story show <project_id> <story_id>}"
  local story_id="${2:?Usage: lt story show <project_id> <story_id>}"
  local data
  data=$(api_get "/projects/$project_id/stories/$story_id")
  echo "$data" | jq '{
    id,
    title,
    description,
    story_type,
    current_state,
    estimate,
    owner_ids: [.owners[]?.user_id],
    url,
    labels: [.labels[]?.name],
    created_at,
    updated_at
  }'
}

cmd_story_create() {
  local project_id="${1:?Usage: lt story create <project_id> --name \"...\"}"
  shift
  local name="" story_type="feature" estimate="" label="" description=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name)        name="${2:?--name requires a value}"; shift 2 ;;
      --type)        story_type="${2:?--type requires a value}"; shift 2 ;;
      --estimate)    estimate="${2:?--estimate requires a value}"; shift 2 ;;
      --label)       label="${2:?--label requires a value}"; shift 2 ;;
      --description) description="${2:?--description requires a value}"; shift 2 ;;
      *)             die "Unknown flag: $1" ;;
    esac
  done
  [[ -n "$name" ]] || die "--name is required"

  local json
  json=$(jq -n --arg name "$name" --arg type "$story_type" '{name: $name, story_type: $type}')
  [[ -n "$estimate" ]] && json=$(echo "$json" | jq --argjson est "$estimate" '. + {estimate: $est}')
  [[ -n "$label" ]] && json=$(echo "$json" | jq --arg lbl "$label" '. + {labels: [{name: $lbl}]}')
  [[ -n "$description" ]] && json=$(echo "$json" | jq --arg desc "$description" '. + {description: $desc}')

  local result
  result=$(api_post "/projects/$project_id/stories/" "$json")
  local new_id
  new_id=$(echo "$result" | jq -r '.id')
  echo "Created story #$new_id"
  echo "$result" | jq '{id, title, story_type, current_state, url}'
}

cmd_story_update() {
  local project_id="${1:?Usage: lt story update <project_id> <story_id> [flags]}"
  local story_id="${2:?Usage: lt story update <project_id> <story_id> [flags]}"
  shift 2
  local state="" estimate="" owner_ids=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --state)      state="${2:?--state requires a value}"; shift 2 ;;
      --estimate)   estimate="${2:?--estimate requires a value}"; shift 2 ;;
      --owner-ids)  owner_ids="${2:?--owner-ids requires a value}"; shift 2 ;;
      *)            die "Unknown flag: $1" ;;
    esac
  done
  [[ -n "$state" || -n "$estimate" || -n "$owner_ids" ]] || die "At least one of --state, --estimate, or --owner-ids is required"

  local json
  json=$(jq -n '{}')
  [[ -n "$state" ]] && json=$(echo "$json" | jq --arg s "$state" '. + {current_state: $s}')
  [[ -n "$estimate" ]] && json=$(echo "$json" | jq --argjson e "$estimate" '. + {estimate: $e}')
  [[ -n "$owner_ids" ]] && json=$(echo "$json" | jq --argjson ids "[$owner_ids]" '. + {owner_ids: $ids}')

  local result
  result=$(api_put "/projects/$project_id/stories/$story_id" "$json")
  echo "Updated story #$story_id"
  echo "$result" | jq '{id, title, story_type, current_state, estimate, owner_ids: [.owners[]?.user_id], url}'
}

cmd_story_label() {
  local project_id="${1:?Usage: lt story label <project_id> <story_id> --label \"...\"}"
  local story_id="${2:?Usage: lt story label <project_id> <story_id> --label \"...\"}"
  shift 2
  local label=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --label) label="${2:?--label requires a value}"; shift 2 ;;
      *)       die "Unknown flag: $1" ;;
    esac
  done
  [[ -n "$label" ]] || die "--label is required"

  local json
  json=$(jq -n --arg lbl "$label" '{label: {name: $lbl}}')
  local result
  result=$(api_post "/projects/$project_id/stories/$story_id/labels" "$json")
  echo "Added label '$label' to story #$story_id"
}

cmd_story_comments() {
  local project_id="${1:?Usage: lt story comments <project_id> <story_id>}"
  local story_id="${2:?Usage: lt story comments <project_id> <story_id>}"
  local data
  data=$(api_get "/projects/$project_id/stories/$story_id/comments")
  local count
  count=$(echo "$data" | jq 'length')
  if [[ "$count" -eq 0 ]]; then
    echo "No comments on story #$story_id"
    return
  fi
  echo "$data" | jq -r '.[] | "--- Comment #\(.id) at \(.created_at) ---\n\(.text)\n"'
}

cmd_story_comment() {
  local project_id="${1:?Usage: lt story comment <project_id> <story_id> --text \"...\"}"
  local story_id="${2:?Usage: lt story comment <project_id> <story_id> --text \"...\"}"
  shift 2
  local text=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --text) text="${2:?--text requires a value}"; shift 2 ;;
      *)      die "Unknown flag: $1" ;;
    esac
  done
  [[ -n "$text" ]] || die "--text is required"

  local json
  json=$(jq -n --arg t "$text" '{text: $t}')
  local result
  result=$(api_post "/projects/$project_id/stories/$story_id/comments" "$json")
  echo "Comment added to story #$story_id"
}

cmd_schema() {
  local path="${1:-}"
  if [[ -z "$path" ]]; then
    cat <<'LIST'
lt schema — Show API endpoint details

Usage:
  lt schema <endpoint>

Available endpoints:
  me                    GET /me
  projects.list         GET /projects
  stories.list          GET /projects/{project_id}/stories
  stories.get           GET /projects/{project_id}/stories/{story_id}
  stories.create        POST /projects/{project_id}/stories
  stories.update        PUT /projects/{project_id}/stories/{story_id}
  stories.comments.list GET /projects/{project_id}/stories/{story_id}/comments
  stories.comments.create POST /projects/{project_id}/stories/{story_id}/comments
  stories.labels.create POST /projects/{project_id}/stories/{story_id}/labels

Example:
  lt schema stories.create
LIST
    return
  fi

  local schema
  case "$path" in
    me)
      schema=$(jq -n '{
        description: "Returns information about the authenticated user.",
        httpMethod: "GET",
        path: "/me",
        auth: "X-TrackerToken header (required)",
        parameters: {},
        response: {
          properties: {
            id: {type: "string", description: "User ID"},
            name: {type: "string", description: "Full name"},
            initials: {type: "string", description: "User initials"},
            username: {type: "string", description: "Username"},
            email: {type: "string", description: "Email address"},
            accounts: {type: "array", description: "List of accounts with name, status, plan"},
            projects: {type: "array", description: "List of projects with project_id, project_name, role"}
          }
        }
      }') ;;
    projects|projects.list)
      schema=$(jq -n '{
        description: "Lists all projects accessible to the authenticated user.",
        httpMethod: "GET",
        path: "/projects",
        auth: "X-TrackerToken header (required)",
        parameters: {},
        response: {
          type: "array",
          items: {
            properties: {
              id: {type: "string", description: "Project ID"},
              title: {type: "string", description: "Project title"},
              created_at: {type: "string", description: "Creation timestamp"},
              updated_at: {type: "string", description: "Last update timestamp"}
            }
          }
        }
      }') ;;
    stories.list)
      schema=$(jq -n '{
        description: "Lists stories in a project. Paginated — default page size is 50. Use offset/limit query params, or the --all flag on the CLI.",
        httpMethod: "GET",
        path: "/projects/{project_id}/stories",
        auth: "X-TrackerToken header (required)",
        parameters: {
          project_id: {type: "string", location: "path", required: true, description: "Project ID"},
          offset: {type: "integer", location: "query", required: false, description: "Number of stories to skip (pagination)"},
          limit: {type: "integer", location: "query", required: false, description: "Page size (max 50)"}
        },
        notes: "API does not support server-side state filtering. The lt CLI provides --state as a client-side filter applied after fetching.",
        response: {
          type: "array",
          items: {
            properties: {
              id: {type: "string", description: "Story ID"},
              title: {type: "string", description: "Story title"},
              story_type: {type: "string", description: "Type: feature, bug, or chore"},
              current_state: {type: "string", description: "State: unscheduled, unstarted, started, finished, delivered, accepted, rejected"},
              estimate: {type: "integer", description: "Point estimate"},
              labels: {type: "array", description: "Array of label objects with name field"},
              owner_ids: {type: "array", description: "Array of user IDs who own the story"},
              created_at: {type: "string", description: "Creation timestamp"},
              updated_at: {type: "string", description: "Last update timestamp"},
              url: {type: "string", description: "Web URL for the story"}
            }
          }
        }
      }') ;;
    stories.get)
      schema=$(jq -n '{
        description: "Returns details for a single story.",
        httpMethod: "GET",
        path: "/projects/{project_id}/stories/{story_id}",
        auth: "X-TrackerToken header (required)",
        parameters: {
          project_id: {type: "string", location: "path", required: true, description: "Project ID"},
          story_id: {type: "string", location: "path", required: true, description: "Story ID"}
        },
        response: {
          properties: {
            id: {type: "string", description: "Story ID"},
            title: {type: "string", description: "Story title"},
            story_type: {type: "string", description: "Type: feature, bug, or chore"},
            current_state: {type: "string", description: "State: unscheduled, unstarted, started, finished, delivered, accepted, rejected"},
            estimate: {type: "integer", description: "Point estimate"},
            labels: {type: "array", description: "Array of label objects with name field"},
            owner_ids: {type: "array", description: "Array of user IDs who own the story"},
            description: {type: "string", description: "Story description"},
            created_at: {type: "string", description: "Creation timestamp"},
            updated_at: {type: "string", description: "Last update timestamp"},
            url: {type: "string", description: "Web URL for the story"}
          }
        }
      }') ;;
    stories.create)
      schema=$(jq -n '{
        description: "Creates a new story in a project. Note: LiteTracker accepts \"name\" for the title field on create, but returns \"title\" in responses.",
        httpMethod: "POST",
        path: "/projects/{project_id}/stories",
        auth: "X-TrackerToken header (required)",
        parameters: {
          project_id: {type: "string", location: "path", required: true, description: "Project ID"}
        },
        requestBody: {
          properties: {
            name: {type: "string", required: true, description: "Story title (required)"},
            story_type: {type: "string", required: false, description: "Type: feature (default), bug, or chore"},
            estimate: {type: "integer", required: false, description: "Point estimate"},
            description: {type: "string", required: false, description: "Story description"},
            labels: {type: "array", required: false, description: "Array of label objects, e.g. [{\"name\": \"urgent\"}]"}
          }
        },
        notes: [
          "owner_ids is ignored on create — use story update to assign owners"
        ],
        response: {
          properties: {
            id: {type: "string", description: "Created story ID"},
            title: {type: "string", description: "Story title"},
            story_type: {type: "string", description: "Story type"},
            current_state: {type: "string", description: "Initial state"},
            url: {type: "string", description: "Web URL for the story"}
          }
        }
      }') ;;
    stories.update)
      schema=$(jq -n '{
        description: "Updates a story'\''s estimate, state, and/or owners. All parameters are optional — include only what you want to change.",
        httpMethod: "PUT",
        path: "/projects/{project_id}/stories/{story_id}",
        auth: "X-TrackerToken header (required)",
        parameters: {
          project_id: {type: "string", location: "path", required: true, description: "Project ID"},
          story_id: {type: "string", location: "path", required: true, description: "Story ID"}
        },
        requestBody: {
          properties: {
            current_state: {type: "string", required: false, description: "State: unscheduled, unstarted, planned, started, finished, delivered, rejected, accepted"},
            estimate: {type: "integer", required: false, description: "Point estimate"},
            owner_ids: {type: "array", required: false, description: "Array of user IDs to assign as owners"}
          }
        },
        notes: [
          "State transitions follow AASM rules (e.g., cannot accept a story that has not been delivered)",
          "For chores and releases, finish automatically maps to accept",
          "Feature/bug stories require an estimate before starting (unless chores/releases)"
        ],
        response: {
          properties: {
            id: {type: "string", description: "Story ID"},
            title: {type: "string", description: "Story title"},
            story_type: {type: "string", description: "Story type"},
            current_state: {type: "string", description: "Updated state"},
            estimate: {type: "integer", description: "Point estimate"},
            owner_ids: {type: "array", description: "Updated array of user IDs assigned as owners"},
            url: {type: "string", description: "Web URL for the story"}
          }
        }
      }') ;;
    stories.comments|stories.comments.list)
      schema=$(jq -n '{
        description: "Lists all comments on a story.",
        httpMethod: "GET",
        path: "/projects/{project_id}/stories/{story_id}/comments",
        auth: "X-TrackerToken header (required)",
        parameters: {
          project_id: {type: "string", location: "path", required: true, description: "Project ID"},
          story_id: {type: "string", location: "path", required: true, description: "Story ID"}
        },
        response: {
          type: "array",
          items: {
            properties: {
              id: {type: "string", description: "Comment ID"},
              text: {type: "string", description: "Comment text"},
              person_id: {type: "string", description: "ID of the commenter"},
              story_id: {type: "string", description: "Parent story ID"},
              created_at: {type: "string", description: "Creation timestamp"},
              updated_at: {type: "string", description: "Last update timestamp"}
            }
          }
        }
      }') ;;
    stories.comments.create)
      schema=$(jq -n '{
        description: "Adds a comment to a story.",
        httpMethod: "POST",
        path: "/projects/{project_id}/stories/{story_id}/comments",
        auth: "X-TrackerToken header (required)",
        parameters: {
          project_id: {type: "string", location: "path", required: true, description: "Project ID"},
          story_id: {type: "string", location: "path", required: true, description: "Story ID"}
        },
        requestBody: {
          properties: {
            text: {type: "string", required: true, description: "Comment text (required)"}
          }
        },
        response: {
          properties: {
            id: {type: "string", description: "Comment ID"},
            text: {type: "string", description: "Comment text"},
            person_id: {type: "string", description: "ID of the commenter"},
            created_at: {type: "string", description: "Creation timestamp"}
          }
        }
      }') ;;
    stories.labels|stories.labels.create)
      schema=$(jq -n '{
        description: "Adds a label to a story.",
        httpMethod: "POST",
        path: "/projects/{project_id}/stories/{story_id}/labels",
        auth: "X-TrackerToken header (required)",
        parameters: {
          project_id: {type: "string", location: "path", required: true, description: "Project ID"},
          story_id: {type: "string", location: "path", required: true, description: "Story ID"}
        },
        requestBody: {
          properties: {
            label: {type: "object", required: true, description: "Label object with name field, e.g. {\"label\": {\"name\": \"urgent\"}}"}
          }
        },
        response: {
          properties: {
            id: {type: "string", description: "Label ID"},
            name: {type: "string", description: "Label name"}
          }
        }
      }') ;;
    *)
      die "Unknown schema: $path. Run 'lt schema' to see available endpoints." ;;
  esac

  echo "$schema"
}

cmd_cache_sync() {
  check_cache_deps
  local with_descriptions=0 with_comments=0 full=0 quiet=0 start_offset=0
  local project_ids=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --with-descriptions) with_descriptions=1; shift ;;
      --with-comments)     with_comments=1; shift ;;
      --full)              full=1; shift ;;
      --quiet)             quiet=1; shift ;;
      --start-page)
        [[ -n "${2:-}" ]] || die "--start-page requires a value"
        require_int "$2" "--start-page"
        [[ "$2" -ge 1 ]] || die "--start-page must be >= 1"
        start_offset=$(( ($2 - 1) * 50 ))
        shift 2 ;;
      --start-offset)
        [[ -n "${2:-}" ]] || die "--start-offset requires a value"
        require_int "$2" "--start-offset"
        start_offset="$2"
        shift 2 ;;
      --) shift; while [[ $# -gt 0 ]]; do project_ids+=("$1"); shift; done ;;
      -*) die "Unknown flag: $1" ;;
      *)  project_ids+=("$1"); shift ;;
    esac
  done
  [[ ${#project_ids[@]} -gt 0 ]] || die "Usage: lt cache sync <project_id>... [--full] [--with-descriptions] [--with-comments] [--start-page N | --start-offset N] [--quiet]"

  if [[ "$start_offset" -gt 0 && "$full" -eq 1 ]]; then
    die "--start-page/--start-offset cannot be combined with --full (resume only makes sense against an existing cache)"
  fi
  if [[ "$start_offset" -gt 0 && ${#project_ids[@]} -gt 1 ]]; then
    die "--start-page/--start-offset only makes sense with a single project"
  fi

  cache_init

  local pid
  for pid in "${project_ids[@]}"; do
    require_int "$pid" "project_id"
    cache_sync_one_project "$pid" "$full" "$with_descriptions" "$with_comments" "$quiet" "$start_offset"
  done
}

cache_sync_one_project() {
  local project_id="$1" full="$2" with_descriptions="$3" with_comments="$4" quiet="$5" start_offset="${6:-0}"
  local started_at finished_at status="ok" error=""
  local stories_inserted=0 stories_updated=0 stories_unchanged=0
  local pages_fetched=0 comments_fetched=0 descriptions_fetched=0

  started_at=$(date -u +"%Y-%m-%dT%H:%M:%SZ")

  # Ensure the project row exists. Look up the title from /projects.
  local projects_json title
  projects_json=$(api_get "/projects")
  title=$(echo "$projects_json" | jq -r --argjson pid "$project_id" '.[] | select(.id == $pid) | .title // empty' | head -1)
  cache_upsert_project "$project_id" "$title" "$projects_json"

  if [[ "$full" -eq 1 ]]; then
    [[ "$quiet" -eq 1 ]] || echo "[$project_id] --full: dropping local rows"
    cache_db "DELETE FROM stories WHERE project_id = $project_id;"
  fi

  local page_size=50
  if [[ "$start_offset" -gt 0 ]]; then
    local start_page=$(( start_offset / page_size + 1 ))
    [[ "$quiet" -eq 1 ]] || echo "[$project_id] resuming stories sync at page $start_page (offset $start_offset)"
  else
    [[ "$quiet" -eq 1 ]] || echo "[$project_id] syncing stories from /projects/$project_id/stories"
  fi

  local offset=$start_offset page count
  local page_num=$(( start_offset / page_size + 1 ))
  while :; do
    local page
    page=$(api_get "/projects/$project_id/stories?limit=${page_size}&offset=${offset}")
    count=$(echo "$page" | jq 'length')
    if [[ "$count" -gt 0 ]]; then
      local counts
      counts=$(cache_sync_page "$project_id" "$page")
      local p_ins p_upd p_unc
      p_ins=$(echo "$counts" | awk -F= '/^inserted/  {print $2}')
      p_upd=$(echo "$counts" | awk -F= '/^updated/   {print $2}')
      p_unc=$(echo "$counts" | awk -F= '/^unchanged/ {print $2}')
      stories_inserted=$((stories_inserted + p_ins))
      stories_updated=$((stories_updated + p_upd))
      stories_unchanged=$((stories_unchanged + p_unc))
      pages_fetched=$((pages_fetched + 1))
      [[ "$quiet" -eq 1 ]] || printf "[%s] page %3d (offset %5d) +%d ~%d =%d\n" \
        "$project_id" "$page_num" "$offset" "$p_ins" "$p_upd" "$p_unc"
    fi
    [[ "$count" -lt "$page_size" ]] && break
    offset=$((offset + page_size))
    page_num=$((page_num + 1))
  done

  if [[ "$with_descriptions" -eq 1 ]]; then
    descriptions_fetched=$(cache_sync_descriptions "$project_id" "$quiet")
  fi

  if [[ "$with_comments" -eq 1 ]]; then
    comments_fetched=$(cache_sync_comments "$project_id" "$quiet")
  fi

  finished_at=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
  cache_db <<SQL
UPDATE projects SET last_synced_at = '$finished_at' WHERE id = $project_id;
INSERT INTO sync_log(project_id, started_at, finished_at, pages_fetched, stories_inserted, stories_updated, stories_unchanged, comments_fetched, descriptions_fetched, status, error)
VALUES ($project_id, '$started_at', '$finished_at', $pages_fetched, $stories_inserted, $stories_updated, $stories_unchanged, $comments_fetched, $descriptions_fetched, '$status', '$error');
SQL

  echo "[$project_id] done: +${stories_inserted} new, ~${stories_updated} updated, =${stories_unchanged} unchanged (pages: $pages_fetched, descriptions: $descriptions_fetched, comments: $comments_fetched)"
}

# Upsert one project row given id, title, and the full /projects list JSON.
cache_upsert_project() {
  local project_id="$1" title="$2" projects_json="$3"
  local tmp
  tmp=$(mktemp)
  echo "$projects_json" | jq --argjson pid "$project_id" '.[] | select(.id == $pid)' > "$tmp"
  cache_db <<SQL
INSERT INTO projects(id, title, data, last_synced_at)
VALUES ($project_id, $(printf "'%s'" "${title//\'/\'\'}"), readfile('$tmp'), COALESCE((SELECT last_synced_at FROM projects WHERE id = $project_id), NULL))
ON CONFLICT(id) DO UPDATE SET title = excluded.title, data = excluded.data;
SQL
  rm -f "$tmp"
}

# Sync one page of /stories JSON into the cache.
# Echoes three lines: inserted=N, updated=N, unchanged=N.
cache_sync_page() {
  local project_id="$1" page_json="$2"
  local tmp
  tmp=$(mktemp)
  echo "$page_json" > "$tmp"

  cache_db <<SQL
BEGIN IMMEDIATE;

CREATE TEMP TABLE incoming(
  id INTEGER PRIMARY KEY,
  title TEXT, story_type TEXT, current_state TEXT, estimate INTEGER, url TEXT,
  created_at TEXT, updated_at TEXT, accepted_at TEXT, data TEXT
);
CREATE TEMP TABLE incoming_labels(story_id INTEGER, label TEXT);
CREATE TEMP TABLE incoming_owners(story_id INTEGER, owner_id INTEGER);

INSERT INTO incoming(id, title, story_type, current_state, estimate, url, created_at, updated_at, accepted_at, data)
SELECT
  CAST(json_extract(value, '\$.id') AS INTEGER),
  json_extract(value, '\$.title'),
  json_extract(value, '\$.story_type'),
  json_extract(value, '\$.current_state'),
  CAST(json_extract(value, '\$.estimate') AS INTEGER),
  json_extract(value, '\$.url'),
  json_extract(value, '\$.created_at'),
  json_extract(value, '\$.updated_at'),
  json_extract(value, '\$.accepted_at'),
  value
FROM json_each(readfile('$tmp'));

INSERT INTO incoming_labels(story_id, label)
SELECT
  CAST(json_extract(s.value, '\$.id') AS INTEGER),
  json_extract(l.value, '\$.name')
FROM json_each(readfile('$tmp')) s, json_each(s.value, '\$.labels') l
WHERE json_extract(l.value, '\$.name') IS NOT NULL;

INSERT INTO incoming_owners(story_id, owner_id)
SELECT
  CAST(json_extract(s.value, '\$.id') AS INTEGER),
  CAST(json_extract(o.value, '\$.user_id') AS INTEGER)
FROM json_each(readfile('$tmp')) s, json_each(s.value, '\$.owners') o
WHERE json_extract(o.value, '\$.user_id') IS NOT NULL;

CREATE TEMP TABLE diff_new AS
  SELECT i.* FROM incoming i LEFT JOIN stories s ON s.id = i.id WHERE s.id IS NULL;
CREATE TEMP TABLE diff_changed AS
  SELECT i.* FROM incoming i JOIN stories s ON s.id = i.id
   WHERE COALESCE(s.updated_at,'') <> COALESCE(i.updated_at,'');

INSERT INTO stories(id, project_id, title, story_type, current_state, estimate, url, created_at, updated_at, accepted_at, data, cached_at)
SELECT id, $project_id, title, story_type, current_state, estimate, url, created_at, updated_at, accepted_at, data, datetime('now')
FROM diff_new;

UPDATE stories
   SET title         = (SELECT title         FROM diff_changed dc WHERE dc.id = stories.id),
       story_type    = (SELECT story_type    FROM diff_changed dc WHERE dc.id = stories.id),
       current_state = (SELECT current_state FROM diff_changed dc WHERE dc.id = stories.id),
       estimate      = (SELECT estimate      FROM diff_changed dc WHERE dc.id = stories.id),
       url           = (SELECT url           FROM diff_changed dc WHERE dc.id = stories.id),
       updated_at    = (SELECT updated_at    FROM diff_changed dc WHERE dc.id = stories.id),
       accepted_at   = (SELECT accepted_at   FROM diff_changed dc WHERE dc.id = stories.id),
       data          = (SELECT data          FROM diff_changed dc WHERE dc.id = stories.id),
       -- description / comments caches are now stale; clear the marker so
       -- subsequent --with-descriptions / --with-comments re-fetches them.
       description_updated_at = NULL,
       comments_updated_at    = NULL,
       cached_at     = datetime('now')
 WHERE id IN (SELECT id FROM diff_changed);

DELETE FROM story_labels
 WHERE story_id IN (SELECT id FROM diff_new UNION SELECT id FROM diff_changed);
-- OR IGNORE: LT occasionally repeats a label inside a story's labels[] array.
INSERT OR IGNORE INTO story_labels(story_id, label)
SELECT story_id, label FROM incoming_labels
 WHERE story_id IN (SELECT id FROM diff_new UNION SELECT id FROM diff_changed);

DELETE FROM story_owners
 WHERE story_id IN (SELECT id FROM diff_new UNION SELECT id FROM diff_changed);
-- OR IGNORE: LT occasionally repeats an owner inside a story's owners[] array.
INSERT OR IGNORE INTO story_owners(story_id, owner_id)
SELECT story_id, owner_id FROM incoming_owners
 WHERE story_id IN (SELECT id FROM diff_new UNION SELECT id FROM diff_changed);

-- Counts emitted AFTER writes so a rolled-back transaction never lies to
-- the caller about how many rows landed.
.mode list
.headers off
SELECT 'inserted=' || (SELECT COUNT(*) FROM diff_new);
SELECT 'updated='  || (SELECT COUNT(*) FROM diff_changed);
SELECT 'unchanged=' || ((SELECT COUNT(*) FROM incoming) - (SELECT COUNT(*) FROM diff_new) - (SELECT COUNT(*) FROM diff_changed));

COMMIT;
SQL

  rm -f "$tmp"
}

# Re-fetch story descriptions for any story whose description is missing or
# whose cached `description_updated_at` no longer matches the story's
# current `updated_at`. Equality compare — LT returns `updated_at` as a free
# form string, so ordering is unreliable. Echoes the count fetched.
cache_sync_descriptions() {
  local project_id="$1" quiet="$2"
  local ids fetched=0 sid data tmp
  ids=$(cache_db "SELECT id FROM stories WHERE project_id = $project_id AND (description IS NULL OR description_updated_at IS NULL OR description_updated_at <> updated_at) ORDER BY id;")
  [[ -z "$ids" ]] && { echo 0; return; }
  local total
  total=$(echo "$ids" | wc -l)
  [[ "$quiet" -eq 1 ]] || echo "[$project_id] fetching $total story descriptions" >&2
  for sid in $ids; do
    data=$(api_get "/projects/$project_id/stories/$sid")
    tmp=$(mktemp)
    echo "$data" > "$tmp"
    cache_db <<SQL
UPDATE stories
   SET description            = json_extract(readfile('$tmp'), '\$.description'),
       description_updated_at = updated_at
 WHERE id = $sid;
SQL
    rm -f "$tmp"
    fetched=$((fetched + 1))
    if [[ "$quiet" -eq 0 && $((fetched % 50)) -eq 0 ]]; then
      echo "[$project_id] descriptions: $fetched / $total" >&2
    fi
  done
  echo "$fetched"
}

# Re-fetch comments for any story whose cached `comments_updated_at` no
# longer matches the story's current `updated_at`. Equality compare — see
# cache_sync_descriptions for rationale. Echoes the count fetched.
cache_sync_comments() {
  local project_id="$1" quiet="$2"
  local ids fetched=0 sid data tmp
  ids=$(cache_db "SELECT id FROM stories WHERE project_id = $project_id AND (comments_updated_at IS NULL OR comments_updated_at <> updated_at) ORDER BY id;")
  [[ -z "$ids" ]] && { echo 0; return; }
  local total
  total=$(echo "$ids" | wc -l)
  [[ "$quiet" -eq 1 ]] || echo "[$project_id] fetching comments for $total stories" >&2
  for sid in $ids; do
    data=$(api_get "/projects/$project_id/stories/$sid/comments")
    tmp=$(mktemp)
    echo "$data" > "$tmp"
    cache_db <<SQL
BEGIN IMMEDIATE;
DELETE FROM comments WHERE story_id = $sid;
INSERT INTO comments(id, story_id, text, person_id, created_at, updated_at, data)
SELECT
  CAST(json_extract(value, '\$.id') AS INTEGER),
  $sid,
  json_extract(value, '\$.text'),
  CAST(json_extract(value, '\$.person_id') AS INTEGER),
  json_extract(value, '\$.created_at'),
  json_extract(value, '\$.updated_at'),
  value
FROM json_each(readfile('$tmp'));
UPDATE stories SET comments_updated_at = updated_at WHERE id = $sid;
COMMIT;
SQL
    rm -f "$tmp"
    fetched=$((fetched + 1))
    if [[ "$quiet" -eq 0 && $((fetched % 50)) -eq 0 ]]; then
      echo "[$project_id] comments: $fetched / $total" >&2
    fi
  done
  echo "$fetched"
}

cmd_cache_stories() {
  check_cache_deps
  local project_id="${1:?Usage: lt cache stories <project_id> [flags]}"
  shift
  require_int "$project_id" "project_id"
  local state="" type="" label="" since="" limit="" offset=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --state)  state="${2:?--state requires a value}"; shift 2 ;;
      --type)   type="${2:?--type requires a value}"; shift 2 ;;
      --label)  label="${2:?--label requires a value}"; shift 2 ;;
      --since)  since="${2:?--since requires a value}"; shift 2 ;;
      --limit)  limit="${2:?--limit requires a value}"; require_int "$limit" "--limit"; shift 2 ;;
      --offset) offset="${2:?--offset requires a value}"; require_int "$offset" "--offset"; shift 2 ;;
      *) die "Unknown flag: $1" ;;
    esac
  done

  [[ -f "$CACHE_DB" ]] || die "No cache found. Run 'lt cache sync $project_id' first."

  local where="WHERE s.project_id = $project_id"
  if [[ -n "$state"  ]]; then where="$where AND s.current_state = $(sql_lit "$state")"; fi
  if [[ -n "$type"   ]]; then where="$where AND s.story_type    = $(sql_lit "$type")";  fi
  if [[ -n "$since"  ]]; then where="$where AND s.updated_at   >= $(sql_lit "$since")"; fi
  local join=""
  if [[ -n "$label" ]]; then
    join="JOIN story_labels sl ON sl.story_id = s.id AND sl.label = $(sql_lit "$label")"
  fi
  local pagination=""
  if [[ -n "$limit" ]]; then
    pagination="LIMIT $limit"
    [[ -n "$offset" ]] && pagination="$pagination OFFSET $offset"
  fi

  (
    echo -e "ID\tTYPE\tSTATE\tTITLE"
    cache_db <<SQL
.mode tabs
.headers off
SELECT s.id, s.story_type, s.current_state, s.title
FROM stories s
$join
$where
ORDER BY s.id DESC
$pagination;
SQL
  ) | column -ts $'\t'
}

cmd_cache_stats() {
  check_cache_deps
  [[ -f "$CACHE_DB" ]] || die "No cache yet. Run 'lt cache sync <project_id>' first."
  local project_id="${1:-}"
  local where=""
  [[ -n "$project_id" ]] && { require_int "$project_id" "project_id"; where="WHERE p.id = $project_id"; }

  echo "Cache: $CACHE_DB"
  echo
  (
    echo -e "PROJECT\tTITLE\tSTORIES\tLABELS\tLAST_SYNCED"
    cache_db <<SQL
.mode tabs
.headers off
SELECT
  p.id,
  COALESCE(p.title, '(unknown)'),
  (SELECT COUNT(*) FROM stories s WHERE s.project_id = p.id),
  (SELECT COUNT(DISTINCT label) FROM story_labels sl JOIN stories s ON s.id = sl.story_id WHERE s.project_id = p.id),
  COALESCE(p.last_synced_at, '-')
FROM projects p
$where
ORDER BY p.id;
SQL
  ) | column -ts $'\t'

  echo
  echo "Recent sync runs:"
  (
    echo -e "PROJECT\tFINISHED\tPAGES\t+NEW\t~UPD\t=UNCH\tDESCR\tCOMMENTS\tSTATUS"
    cache_db <<SQL
.mode tabs
.headers off
SELECT project_id, finished_at, pages_fetched, stories_inserted, stories_updated, stories_unchanged, descriptions_fetched, comments_fetched, status
FROM sync_log
${where//p.id/project_id}
ORDER BY id DESC
LIMIT 10;
SQL
  ) | column -ts $'\t'
  echo
  echo "Note: rows reflect each sync — stories deleted in LT after their first sync may persist locally until 'lt cache sync --full'."
}

cmd_cache_clear() {
  check_cache_deps
  [[ -f "$CACHE_DB" ]] || die "No cache to clear."
  local project_id="${1:-}"
  if [[ -z "$project_id" ]]; then
    read -rp "Drop the entire cache at $CACHE_DB? [y/N] " ans
    [[ "$ans" =~ ^[Yy]$ ]] || { echo "Aborted."; return; }
    rm -f "$CACHE_DB" "$CACHE_DB-wal" "$CACHE_DB-shm"
    echo "Removed $CACHE_DB"
    return
  fi
  require_int "$project_id" "project_id"
  read -rp "Drop cached rows for project $project_id? [y/N] " ans
  [[ "$ans" =~ ^[Yy]$ ]] || { echo "Aborted."; return; }
  cache_db <<SQL
DELETE FROM sync_log WHERE project_id = $project_id;
DELETE FROM stories  WHERE project_id = $project_id;
DELETE FROM projects WHERE id = $project_id;
SQL
  echo "Cleared project $project_id from cache."
}

# Quote a string as a SQL literal: wrap in single quotes, double any embedded
# single quotes. Only safe for user-provided plain strings (labels, states).
sql_lit() {
  local s="${1//\'/\'\'}"
  printf "'%s'" "$s"
}

