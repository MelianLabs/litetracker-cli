#!/usr/bin/env bash
set -euo pipefail

VERSION="0.2.0"
BASE_URL="https://app.litetracker.com/services/v5"
CONFIG_DIR="$HOME/.lt"
TOKEN_FILE="$CONFIG_DIR/api_token"

# Canonical list of "in-flight" states — everything that isn't shipped
# (accepted) and isn't in the icebox (unscheduled). Used by --active on
# stories, cache sync, and cache stories. The server-side filter DSL only
# accepts ONE clause per request; --active sends `filter=-state:accepted`
# server-side and drops `unscheduled` client-side after the response.
ACTIVE_STATES=(unstarted planned started finished delivered rejected)

# The LT API has two surprising behaviors we learned empirically:
#
# 1. `offset` is silently ignored when `filter=` is in the query string.
#    Paginating a filtered list will loop forever (each "next page" returns
#    the same first slice). Workaround: request a high `limit` and accept
#    the answer in one shot. The server's 30s gateway timeout is the real
#    cap there.
# 2. The documented "50 per page" cap is not actually enforced. `limit=10000`
#    works for small projects; large/legacy projects (e.g. 254 with ~17k
#    stories) 504 on anything bigger than ~50 even unfiltered.
#
# So we use two separate page sizes:
#   - STORIES_PAGE_SIZE_FILTERED  high (filtered queries can't paginate)
#   - STORIES_PAGE_SIZE_UNFILTERED low (lets pagination work on huge projects)
#
# Override with LT_STORIES_PAGE_SIZE_FILTERED / LT_STORIES_PAGE_SIZE.
STORIES_PAGE_SIZE="${LT_STORIES_PAGE_SIZE:-50}"
STORIES_PAGE_SIZE_FILTERED="${LT_STORIES_PAGE_SIZE_FILTERED:-1000}"

# --- Helpers ---

die() {
  echo "Error: $1" >&2
  exit 1
}

check_deps() {
  command -v curl >/dev/null 2>&1 || die "curl is required. Install it with: sudo apt install curl"
  command -v jq >/dev/null 2>&1 || die "jq is required. Install it with: sudo apt install jq"
}

check_cache_deps() {
  command -v sqlite3 >/dev/null 2>&1 || die "sqlite3 is required for cache commands. Install it with: sudo apt install sqlite3"
}

load_token() {
  [[ -f "$TOKEN_FILE" ]] || die "Not authenticated. Run 'lt auth' first."
  TOKEN=$(<"$TOKEN_FILE")
  [[ -n "$TOKEN" ]] || die "API token is empty. Run 'lt auth' to reconfigure."
}

api_get() {
  local url="$BASE_URL$1"
  local max_attempts="${LT_API_MAX_ATTEMPTS:-5}" attempt=1 sleep_s=1
  local response http_code body curl_rc

  while :; do
    local t0 t1 ms
    [[ "${LT_DEBUG:-0}" == "1" ]] && t0=$(date +%s%3N 2>/dev/null || python3 -c 'import time; print(int(time.time()*1000))')
    if response=$(curl -sS -w "\n%{http_code}" -H "X-TrackerToken: $TOKEN" "$url" 2>&1); then
      curl_rc=0
      http_code=$(echo "$response" | tail -1)
      body=$(echo "$response" | sed '$d')
    else
      curl_rc=$?
      http_code=0
      body="$response"
    fi
    if [[ "${LT_DEBUG:-0}" == "1" ]]; then
      t1=$(date +%s%3N 2>/dev/null || python3 -c 'import time; print(int(time.time()*1000))')
      ms=$(( t1 - t0 ))
      local sz="?" cnt="?"
      if [[ "$curl_rc" -eq 0 && "$http_code" -lt 400 ]]; then
        sz=$(printf "%s" "$body" | wc -c | tr -d ' ')
        cnt=$(printf "%s" "$body" | jq 'if type=="array" then length else "n/a" end' 2>/dev/null || echo "?")
      fi
      printf "[lt-debug] GET %s -> %s in %sms (%s bytes, %s items)\n" "$url" "$http_code" "$ms" "$sz" "$cnt" >&2
    fi

    # Success or non-retryable 4xx — return / die immediately.
    if [[ "$curl_rc" -eq 0 && "$http_code" -lt 500 ]]; then
      if [[ "$http_code" -ge 400 ]]; then
        die "API error ($http_code): $body"
      fi
      echo "$body"
      return 0
    fi

    if [[ "$attempt" -ge "$max_attempts" ]]; then
      if [[ "$curl_rc" -ne 0 ]]; then
        die "curl failed after $max_attempts attempts (rc=$curl_rc): $body"
      else
        die "API error ($http_code) after $max_attempts attempts: $body"
      fi
    fi

    if [[ "$curl_rc" -ne 0 ]]; then
      echo "Warning: curl failed (rc=$curl_rc), retrying in ${sleep_s}s (attempt $attempt/$max_attempts)" >&2
    else
      echo "Warning: API returned $http_code, retrying in ${sleep_s}s (attempt $attempt/$max_attempts)" >&2
    fi
    sleep "$sleep_s"
    sleep_s=$((sleep_s * 2))
    attempt=$((attempt + 1))
  done
}

api_post() {
  local response http_code body
  response=$(curl -sS -w "\n%{http_code}" \
    -X POST \
    -H "X-TrackerToken: $TOKEN" \
    -H "Content-Type: application/json" \
    -d "$2" \
    "$BASE_URL$1")
  http_code=$(echo "$response" | tail -1)
  body=$(echo "$response" | sed '$d')
  if [[ "$http_code" -ge 400 ]]; then
    die "API error ($http_code): $body"
  fi
  echo "$body"
}

api_put() {
  local response http_code body
  response=$(curl -sS -w "\n%{http_code}" \
    -X PUT \
    -H "X-TrackerToken: $TOKEN" \
    -H "Content-Type: application/json" \
    -d "$2" \
    "$BASE_URL$1")
  http_code=$(echo "$response" | tail -1)
  body=$(echo "$response" | sed '$d')
  if [[ "$http_code" -ge 400 ]]; then
    die "API error ($http_code): $body"
  fi
  echo "$body"
}

# --- Cache (local SQLite mirror) ---
#
# Layout: $CACHE_DIR is created lazily. All projects live in one DB.
# Schema is embedded inline below so the install stays a single file.

CACHE_DIR="$CONFIG_DIR/cache"
CACHE_DB="$CACHE_DIR/litetracker.db"

cache_schema_sql() {
  cat <<'SQL'
PRAGMA foreign_keys = ON;
PRAGMA journal_mode = WAL;

CREATE TABLE IF NOT EXISTS projects (
  id             INTEGER PRIMARY KEY,
  title          TEXT,
  data           TEXT,
  last_synced_at TEXT
);

CREATE TABLE IF NOT EXISTS stories (
  id                     INTEGER PRIMARY KEY,
  project_id             INTEGER NOT NULL REFERENCES projects(id),
  title                  TEXT,
  story_type             TEXT,
  current_state          TEXT,
  estimate               INTEGER,
  url                    TEXT,
  created_at             TEXT,
  updated_at             TEXT,
  accepted_at            TEXT,
  description            TEXT,
  -- These two cache the value of `updated_at` that was current when we last
  -- fetched the description / comments. Compare with `=` to decide re-fetch
  -- (LT returns `updated_at` as a free-form string, not ISO, so ordering
  -- comparisons are unreliable across formats).
  description_updated_at TEXT,
  comments_updated_at    TEXT,
  data                   TEXT,
  cached_at              TEXT
);
CREATE INDEX IF NOT EXISTS idx_stories_project ON stories(project_id);
CREATE INDEX IF NOT EXISTS idx_stories_state   ON stories(current_state);
CREATE INDEX IF NOT EXISTS idx_stories_type    ON stories(story_type);
CREATE INDEX IF NOT EXISTS idx_stories_updated ON stories(updated_at);

CREATE TABLE IF NOT EXISTS story_labels (
  story_id INTEGER NOT NULL REFERENCES stories(id) ON DELETE CASCADE,
  label    TEXT    NOT NULL,
  PRIMARY KEY (story_id, label)
);
CREATE INDEX IF NOT EXISTS idx_story_labels_label ON story_labels(label);

CREATE TABLE IF NOT EXISTS story_owners (
  story_id INTEGER NOT NULL REFERENCES stories(id) ON DELETE CASCADE,
  owner_id INTEGER NOT NULL,
  PRIMARY KEY (story_id, owner_id)
);

-- People are global: the same person appears in many projects' membership
-- lists, and stories reference them by user_id (== person id). Keeping people
-- separate from the per-project `memberships` join lets us answer both
-- "who are all our users" and "who is on project X, in what role".
CREATE TABLE IF NOT EXISTS people (
  id        INTEGER PRIMARY KEY,
  name      TEXT,
  email     TEXT,
  initials  TEXT,
  username  TEXT,
  data      TEXT,
  cached_at TEXT
);

CREATE TABLE IF NOT EXISTS memberships (
  id         INTEGER PRIMARY KEY,
  project_id INTEGER NOT NULL REFERENCES projects(id) ON DELETE CASCADE,
  person_id  INTEGER NOT NULL REFERENCES people(id),
  role       TEXT,
  data       TEXT,
  cached_at  TEXT
);
CREATE INDEX IF NOT EXISTS idx_memberships_project ON memberships(project_id);
CREATE INDEX IF NOT EXISTS idx_memberships_person  ON memberships(person_id);

CREATE TABLE IF NOT EXISTS comments (
  id         INTEGER PRIMARY KEY,
  story_id   INTEGER NOT NULL REFERENCES stories(id) ON DELETE CASCADE,
  text       TEXT,
  person_id  INTEGER,
  created_at TEXT,
  updated_at TEXT,
  data       TEXT
);
CREATE INDEX IF NOT EXISTS idx_comments_story ON comments(story_id);

CREATE TABLE IF NOT EXISTS sync_log (
  id                   INTEGER PRIMARY KEY AUTOINCREMENT,
  project_id           INTEGER NOT NULL,
  started_at           TEXT,
  finished_at          TEXT,
  pages_fetched        INTEGER,
  stories_inserted     INTEGER,
  stories_updated      INTEGER,
  stories_unchanged    INTEGER,
  comments_fetched     INTEGER,
  descriptions_fetched INTEGER,
  status               TEXT,
  error                TEXT
);
CREATE INDEX IF NOT EXISTS idx_sync_log_project ON sync_log(project_id);
SQL
}

cache_init() {
  check_cache_deps
  mkdir -p "$CACHE_DIR"
  # PRAGMA journal_mode prints "wal" to stdout — swallow it.
  cache_schema_sql | sqlite3 "$CACHE_DB" >/dev/null
}

cache_db() {
  sqlite3 -bail "$CACHE_DB" "$@"
}

# Validate that an argument is a non-negative integer; die otherwise.
require_int() {
  [[ "$1" =~ ^[0-9]+$ ]] || die "$2: expected integer, got '$1'"
}

# URL-encode a single component using jq's @uri filter. Used to safely embed
# filter DSL strings (which contain ':' and '-') into the query string.
url_encode() {
  jq -nr --arg s "$1" '$s | @uri'
}

# Resolve the user-supplied filter flags into the *single* server-side filter
# clause we'll send (LT only honors one) and a JSON object of remaining
# client-side filters to apply after fetching.
#
# Inputs are passed positionally:
#   $1 active (0/1)  $2 state  $3 exclude_state  $4 type  $5 label
#   $6 raw_filter (already-formed DSL string; bypasses all flag mapping)
#
# Outputs (stdout, one per line):
#   server_filter=<dsl_or_empty>
#   client_type=<value_or_empty>
#   client_label=<value_or_empty>
#
# Precedence (most specific wins server-side): raw_filter > active >
# state > exclude_state > label > type. Whatever is "lost" at the server
# boundary falls back to client-side filtering. --active is the only flag
# that turns into multiple server sweeps (one per ACTIVE_STATES entry);
# the caller handles that loop separately.
resolve_filters() {
  local active="$1" state="$2" exclude_state="$3" type="$4" label="$5" raw_filter="$6"
  local server="" client_type="" client_label=""

  if [[ -n "$raw_filter" ]]; then
    server="$raw_filter"
    # If the caller mixed raw filter with friendly flags, layer them
    # client-side rather than silently dropping them.
    client_type="$type"
    client_label="$label"
  elif [[ "$active" -eq 1 ]]; then
    # Active mode does its own multi-sweep — leave server empty here and
    # let the caller loop ACTIVE_STATES.
    client_type="$type"
    client_label="$label"
  elif [[ -n "$state" ]]; then
    server="state:$state"
    client_type="$type"
    client_label="$label"
  elif [[ -n "$exclude_state" ]]; then
    server="-state:$exclude_state"
    client_type="$type"
    client_label="$label"
  elif [[ -n "$label" ]]; then
    server="label:$label"
    client_type="$type"
  elif [[ -n "$type" ]]; then
    server="type:$type"
  fi

  printf "server_filter=%s\nclient_type=%s\nclient_label=%s\n" \
    "$server" "$client_type" "$client_label"
}

# Build the ?filter=...&offset=...&limit=... query string from a server-side
# filter DSL clause (may be empty) plus optional offset/limit.
build_qs() {
  local filter="$1" offset="$2" limit="$3"
  local qs=""
  [[ -n "$filter" ]] && qs="${qs}&filter=$(url_encode "$filter")"
  [[ -n "$offset" ]] && qs="${qs}&offset=${offset}"
  [[ -n "$limit" ]]  && qs="${qs}&limit=${limit}"
  qs="${qs#&}"
  [[ -n "$qs" ]] && qs="?${qs}"
  printf "%s" "$qs"
}

# Validate that --state/--exclude-state/--type/--filter values look sane.
require_state()      { [[ "$1" =~ ^(unscheduled|unstarted|planned|started|finished|delivered|rejected|accepted)$ ]] || die "$2: unknown state '$1'. Valid: unscheduled, unstarted, planned, started, finished, delivered, rejected, accepted"; }
require_story_type() { [[ "$1" =~ ^(feature|bug|chore|release)$ ]] || die "$2: unknown type '$1'. Valid: feature, bug, chore, release"; }

# Fetch /projects/<id>/stories with optional server-side filter, returning
# a single JSON array of all matching rows.
#
# Args:
#   $1 base_path     "/projects/<id>/stories"
#   $2 server_filter raw filter clause; empty for no filter
#   $3 fetch_all     1 to keep paging when filter is empty (always on for sync)
#   $4 offset        only used when fetch_all=0 and no filter
#   $5 limit         only used when fetch_all=0 and no filter (override page size)
#
# Behavior:
#   - Filter present: ONE request with limit=STORIES_PAGE_SIZE. The server
#     ignores `offset` on filtered queries, so pagination would loop
#     forever. We warn (and stop) if the response equals the limit — the
#     user should bump LT_STORIES_PAGE_SIZE.
#   - No filter, fetch_all=1: paginate using offset until a short page lands.
#   - No filter, fetch_all=0: single request honoring user-supplied offset/limit.
fetch_stories_list() {
  local base_path="$1" server_filter="$2" fetch_all="$3" user_offset="$4" user_limit="$5"
  local data="[]" page count qs

  if [[ -n "$server_filter" ]]; then
    qs=$(build_qs "$server_filter" "" "$STORIES_PAGE_SIZE_FILTERED")
    page=$(api_get "${base_path}${qs}")
    count=$(echo "$page" | jq 'length')
    data="$page"
    if [[ "$count" -ge "$STORIES_PAGE_SIZE_FILTERED" ]]; then
      echo "Warning: filtered result hit the limit ($STORIES_PAGE_SIZE_FILTERED rows). The LT API ignores 'offset' on filtered queries, so we cannot page further. Bump LT_STORIES_PAGE_SIZE_FILTERED to fetch the rest." >&2
    fi
    printf "%s" "$data"
    return
  fi

  if [[ "$fetch_all" -eq 1 ]]; then
    local cur_offset=0
    while :; do
      qs=$(build_qs "" "$cur_offset" "$STORIES_PAGE_SIZE")
      page=$(api_get "${base_path}${qs}")
      count=$(echo "$page" | jq 'length')
      data=$(jq -s 'add' <(echo "$data") <(echo "$page"))
      [[ "$count" -lt "$STORIES_PAGE_SIZE" ]] && break
      cur_offset=$((cur_offset + STORIES_PAGE_SIZE))
    done
    printf "%s" "$data"
    return
  fi

  qs=$(build_qs "" "$user_offset" "${user_limit:-$STORIES_PAGE_SIZE}")
  api_get "${base_path}${qs}"
}

# --- Commands ---

cmd_auth() {
  echo "Enter your LiteTracker API token."
  echo "You can find it at: https://app.litetracker.com/edit"
  echo ""
  read -rp "API Token: " token
  [[ -n "$token" ]] || die "Token cannot be empty."

  mkdir -p "$CONFIG_DIR"
  echo "$token" > "$TOKEN_FILE"
  chmod 600 "$TOKEN_FILE"

  # Verify token works
  TOKEN="$token"
  local me
  me=$(api_get "/me") || die "Token verification failed. Check your token and try again."
  local name
  name=$(echo "$me" | jq -r '.name // "Unknown"')
  echo "Authenticated as: $name"
  echo "Token saved to $TOKEN_FILE"
}

cmd_me() {
  local data
  data=$(api_get "/me")
  echo "$data" | jq '{
    id,
    name,
    initials,
    username,
    email,
    accounts: [.accounts[] | {name, status, plan}],
    projects: [.projects[] | {project_id, project_name, role}]
  }'
}

cmd_projects() {
  local data
  data=$(api_get "/projects")
  (
    echo -e "ID\tTITLE"
    echo "$data" | jq -r '.[] | [(.id|tostring), .title] | @tsv'
  ) | column -ts $'\t'
}

cmd_members() {
  local project_id="${1:?Usage: lt members <project_id>}"
  require_int "$project_id" "project_id"
  local data
  data=$(api_get "/projects/$project_id/memberships")
  (
    echo -e "PERSON_ID\tNAME\tINITIALS\tUSERNAME\tEMAIL\tROLE"
    echo "$data" | jq -r '.[] | [(.person.id|tostring), .person.name, .person.initials, .person.username, .person.email, .role] | @tsv'
  ) | column -ts $'\t'
}

cmd_stories() {
  local project_id="${1:?Usage: lt stories <project_id> [flags]  (see 'lt help')}"
  shift || true
  require_int "$project_id" "project_id"

  local fetch_all=0 active=0
  local state="" exclude_state="" type="" label="" raw_filter=""
  local limit="" offset=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --all)            fetch_all=1; shift ;;
      --active)         active=1; shift ;;
      --state)          state="${2:?--state requires a value}"; require_state "$state" "--state"; shift 2 ;;
      --exclude-state)  exclude_state="${2:?--exclude-state requires a value}"; require_state "$exclude_state" "--exclude-state"; shift 2 ;;
      --type)           type="${2:?--type requires a value}"; require_story_type "$type" "--type"; shift 2 ;;
      --label)          label="${2:?--label requires a value}"; shift 2 ;;
      --filter)         raw_filter="${2:?--filter requires a value}"; shift 2 ;;
      --limit)          limit="${2:?--limit requires a value}"; require_int "$limit" "--limit"; shift 2 ;;
      --offset)         offset="${2:?--offset requires a value}"; require_int "$offset" "--offset"; shift 2 ;;
      *) die "Unknown flag: $1" ;;
    esac
  done

  if [[ "$active" -eq 1 && -n "$state" ]]; then
    die "--active and --state are mutually exclusive (use one or the other)"
  fi
  if [[ "$active" -eq 1 && -n "$exclude_state" ]]; then
    die "--active and --exclude-state are mutually exclusive"
  fi

  local resolved server_filter client_type client_label
  resolved=$(resolve_filters "$active" "$state" "$exclude_state" "$type" "$label" "$raw_filter")
  server_filter=$(echo "$resolved" | awk -F= '/^server_filter=/  {sub(/^server_filter=/,"");  print}')
  client_type=$(  echo "$resolved" | awk -F= '/^client_type=/    {sub(/^client_type=/,"");    print}')
  client_label=$( echo "$resolved" | awk -F= '/^client_label=/   {sub(/^client_label=/,"");   print}')

  local base_path="/projects/$project_id/stories"
  local all_data="[]"

  # Build the list of server-side filter clauses to sweep. --active expands
  # to one clause per ACTIVE_STATES entry (one API call each — no pagination,
  # since the server ignores `offset` on filtered queries and each state
  # bucket fits comfortably under STORIES_PAGE_SIZE). Everything else is a
  # single sweep using the resolved server filter clause.
  local -a sweeps=()
  if [[ "$active" -eq 1 ]]; then
    local s
    for s in "${ACTIVE_STATES[@]}"; do sweeps+=("state:$s"); done
  else
    sweeps=("$server_filter")
  fi

  local sweep page
  for sweep in "${sweeps[@]}"; do
    [[ "${LT_DEBUG:-0}" == "1" ]] && printf "[lt-debug] sweep: filter=%s\n" "${sweep:-<none>}" >&2
    page=$(fetch_stories_list "$base_path" "$sweep" "$fetch_all" "$offset" "$limit")
    all_data=$(jq -s 'add' <(echo "$all_data") <(echo "$page"))
  done

  # Client-side refinement layers on top of the server-side filter.
  if [[ -n "$client_type" ]]; then
    all_data=$(echo "$all_data" | jq --arg t "$client_type" '[.[] | select(.story_type == $t)]')
  fi
  if [[ -n "$client_label" ]]; then
    all_data=$(echo "$all_data" | jq --arg l "$client_label" '[.[] | select(.labels[]?.name == $l)]')
  fi

  local total
  total=$(echo "$all_data" | jq 'length')
  (
    echo -e "ID\tTYPE\tSTATE\tTITLE"
    echo "$all_data" | jq -r '.[] | [(.id|tostring), .story_type, .current_state, .title] | @tsv'
  ) | column -ts $'\t'

  # Truncation note: only meaningful for an unpaged, unfiltered, user-limited
  # call (fetch_stories_list applies STORIES_PAGE_SIZE otherwise).
  if [[ "$fetch_all" -eq 0 && "$active" -eq 0 && -z "$server_clause" && -n "$limit" && "$total" -eq "$limit" ]]; then
    echo >&2
    echo "Note: returned exactly $limit rows — more may exist. Re-run with --all to fetch every page." >&2
  fi
}

cmd_story_show() {
  local project_id="${1:?Usage: lt story show <project_id> <story_id>}"
  local story_id="${2:?Usage: lt story show <project_id> <story_id>}"
  local data
  data=$(api_get "/projects/$project_id/stories/$story_id")
  cache_writethrough_story "$project_id" "$data"
  echo "$data" | jq '{
    id,
    title,
    description,
    story_type,
    current_state,
    estimate,
    owner_ids: [.owners[]?.user_id],
    url,
    labels: [.labels[]?.name],
    created_at,
    updated_at
  }'
}

cmd_story_create() {
  local project_id="${1:?Usage: lt story create <project_id> --name \"...\"}"
  shift
  local name="" story_type="feature" estimate="" label="" description="" owner_ids=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name)        name="${2:?--name requires a value}"; shift 2 ;;
      --type)        story_type="${2:?--type requires a value}"; shift 2 ;;
      --estimate)    estimate="${2:?--estimate requires a value}"; shift 2 ;;
      --label)       label="${2:?--label requires a value}"; shift 2 ;;
      --description) description="${2:?--description requires a value}"; shift 2 ;;
      --owner-ids)   owner_ids="${2:?--owner-ids requires a value}"; shift 2 ;;
      *)             die "Unknown flag: $1" ;;
    esac
  done
  [[ -n "$name" ]] || die "--name is required"

  local json
  json=$(jq -n --arg name "$name" --arg type "$story_type" '{name: $name, story_type: $type}')
  [[ -n "$estimate" ]] && json=$(echo "$json" | jq --argjson est "$estimate" '. + {estimate: $est}')
  [[ -n "$label" ]] && json=$(echo "$json" | jq --arg lbl "$label" '. + {labels: [{name: $lbl}]}')
  [[ -n "$description" ]] && json=$(echo "$json" | jq --arg desc "$description" '. + {description: $desc}')

  local result
  result=$(api_post "/projects/$project_id/stories/" "$json")
  cache_writethrough_story "$project_id" "$result"
  local new_id
  new_id=$(echo "$result" | jq -r '.id')

  # The LT API silently ignores owner_ids on create (verified empirically —
  # labels apply but owners do not), so `--owner-ids` is a convenience wrapper:
  # set the owners with a follow-up update on the freshly-created story.
  if [[ -n "$owner_ids" ]]; then
    local owner_json owner_result
    owner_json=$(jq -n --argjson ids "[$owner_ids]" '{owner_ids: $ids}')
    if owner_result=$(api_put "/projects/$project_id/stories/$new_id" "$owner_json"); then
      result="$owner_result"
      cache_writethrough_story "$project_id" "$result"
    else
      # Create succeeded; only owner assignment failed. Surface the new id so
      # the story is never silently orphaned, and show the manual fix.
      echo "Created story #$new_id" >&2
      die "story #$new_id was created but owner assignment failed (see error above). Assign manually: lt story update $project_id $new_id --owner-ids $owner_ids"
    fi
  fi

  echo "Created story #$new_id"
  echo "$result" | jq '{id, title, story_type, current_state, owner_ids: [.owners[]?.user_id], url}'
}

cmd_story_update() {
  local project_id="${1:?Usage: lt story update <project_id> <story_id> [flags]}"
  local story_id="${2:?Usage: lt story update <project_id> <story_id> [flags]}"
  shift 2
  local state="" estimate="" owner_ids=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --state)      state="${2:?--state requires a value}"; shift 2 ;;
      --estimate)   estimate="${2:?--estimate requires a value}"; shift 2 ;;
      --owner-ids)  owner_ids="${2:?--owner-ids requires a value}"; shift 2 ;;
      *)            die "Unknown flag: $1" ;;
    esac
  done
  [[ -n "$state" || -n "$estimate" || -n "$owner_ids" ]] || die "At least one of --state, --estimate, or --owner-ids is required"

  local json
  json=$(jq -n '{}')
  [[ -n "$state" ]] && json=$(echo "$json" | jq --arg s "$state" '. + {current_state: $s}')
  [[ -n "$estimate" ]] && json=$(echo "$json" | jq --argjson e "$estimate" '. + {estimate: $e}')
  [[ -n "$owner_ids" ]] && json=$(echo "$json" | jq --argjson ids "[$owner_ids]" '. + {owner_ids: $ids}')

  local result
  result=$(api_put "/projects/$project_id/stories/$story_id" "$json")
  cache_writethrough_story "$project_id" "$result"
  echo "Updated story #$story_id"
  echo "$result" | jq '{id, title, story_type, current_state, estimate, owner_ids: [.owners[]?.user_id], url}'
}

cmd_story_label() {
  local project_id="${1:?Usage: lt story label <project_id> <story_id> --label \"...\"}"
  local story_id="${2:?Usage: lt story label <project_id> <story_id> --label \"...\"}"
  shift 2
  local label=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --label) label="${2:?--label requires a value}"; shift 2 ;;
      *)       die "Unknown flag: $1" ;;
    esac
  done
  [[ -n "$label" ]] || die "--label is required"

  local json
  json=$(jq -n --arg lbl "$label" '{label: {name: $lbl}}')
  local result
  result=$(api_post "/projects/$project_id/stories/$story_id/labels" "$json")
  echo "Added label '$label' to story #$story_id"
}

cmd_story_comments() {
