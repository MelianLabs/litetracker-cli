cmd_cache_sync() {
  check_cache_deps
  local with_descriptions=0 with_comments=0 with_members=0 full=0 quiet=0 start_offset=0
  # Default: full unfiltered pagination — works on every project. The
  # server-side filter DSL (used by --active, --state, etc.) is much faster
  # when it works, but on large/legacy projects the filtered endpoint times
  # out at 30s server-side. Keep server-side filters opt-in.
  local active=0
  local state="" exclude_state="" type="" label="" raw_filter=""
  local project_ids=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --with-descriptions) with_descriptions=1; shift ;;
      --with-comments)     with_comments=1; shift ;;
      --with-members)      with_members=1; shift ;;
      --full)              full=1; shift ;;
      --quiet)             quiet=1; shift ;;
      --active)            active=1; shift ;;
      --state)             state="${2:?--state requires a value}"; require_state "$state" "--state"; shift 2 ;;
      --exclude-state)     exclude_state="${2:?--exclude-state requires a value}"; require_state "$exclude_state" "--exclude-state"; shift 2 ;;
      --type)              type="${2:?--type requires a value}"; require_story_type "$type" "--type"; shift 2 ;;
      --label)             label="${2:?--label requires a value}"; shift 2 ;;
      --filter)            raw_filter="${2:?--filter requires a value}"; shift 2 ;;
      --start-page)
        [[ -n "${2:-}" ]] || die "--start-page requires a value"
        require_int "$2" "--start-page"
        [[ "$2" -ge 1 ]] || die "--start-page must be >= 1"
        start_offset=$(( ($2 - 1) * 50 ))
        shift 2 ;;
      --start-offset)
        [[ -n "${2:-}" ]] || die "--start-offset requires a value"
        require_int "$2" "--start-offset"
        start_offset="$2"
        shift 2 ;;
      --) shift; while [[ $# -gt 0 ]]; do project_ids+=("$1"); shift; done ;;
      -*) die "Unknown flag: $1" ;;
      *)  project_ids+=("$1"); shift ;;
    esac
  done
  [[ ${#project_ids[@]} -gt 0 ]] || die "Usage: lt cache sync <project_id>... [flags]  (see 'lt help')"

  if [[ "$start_offset" -gt 0 && "$full" -eq 1 ]]; then
    die "--start-page/--start-offset cannot be combined with --full (resume only makes sense against an existing cache)"
  fi
  if [[ "$start_offset" -gt 0 && ${#project_ids[@]} -gt 1 ]]; then
    die "--start-page/--start-offset only makes sense with a single project"
  fi
  if [[ "$start_offset" -gt 0 && "$active" -eq 1 ]]; then
    die "--start-page/--start-offset is incompatible with --active (the active sweep is one request per state). Drop --active to resume against the unfiltered pagination, or restart the active sweep from scratch."
  fi

  # Build the list of server-side filter clauses to sweep through.
  local -a sweeps=()
  if [[ "$active" -eq 1 ]]; then
    local s
    for s in "${ACTIVE_STATES[@]}"; do sweeps+=("state:$s"); done
  else
    local resolved server_filter
    resolved=$(resolve_filters 0 "$state" "$exclude_state" "$type" "$label" "$raw_filter")
    server_filter=$(echo "$resolved" | awk -F= '/^server_filter=/ {sub(/^server_filter=/,""); print}')
    sweeps=("$server_filter")
  fi

  cache_init

  local pid
  for pid in "${project_ids[@]}"; do
    require_int "$pid" "project_id"
    cache_sync_one_project "$pid" "$full" "$with_descriptions" "$with_comments" "$with_members" "$quiet" "$start_offset" "$active" "${sweeps[@]}"
  done
}

cache_sync_one_project() {
  local project_id="$1" full="$2" with_descriptions="$3" with_comments="$4" with_members="$5" quiet="$6" start_offset="${7:-0}"
  local active="$8"
  shift 8
  local -a sweeps=("$@")

  local started_at finished_at status="ok" error=""
  local stories_inserted=0 stories_updated=0 stories_unchanged=0
  local pages_fetched=0 comments_fetched=0 descriptions_fetched=0 members_fetched=0

  started_at=$(date -u +"%Y-%m-%dT%H:%M:%SZ")

  # Ensure the project row exists. Look up the title from /projects.
  local projects_json title
  projects_json=$(api_get "/projects")
  title=$(echo "$projects_json" | jq -r --argjson pid "$project_id" '.[] | select(.id == $pid) | .title // empty' | head -1)
  cache_upsert_project "$project_id" "$title" "$projects_json"

  if [[ "$full" -eq 1 ]]; then
    [[ "$quiet" -eq 1 ]] || echo "[$project_id] --full: dropping local rows"
    cache_db "DELETE FROM stories WHERE project_id = $project_id;"
  fi

  local mode_label
  if [[ "$active" -eq 1 ]]; then
    mode_label="active sweep (${#sweeps[@]} states)"
  elif [[ -n "${sweeps[0]}" ]]; then
    mode_label="filter=${sweeps[0]}"
  else
    mode_label="unfiltered pagination"
  fi
  [[ "$quiet" -eq 1 ]] || echo "[$project_id] syncing /projects/$project_id/stories ($mode_label)"

  # When there's no filter (e.g. --all-states or raw --filter that resolved
  # to empty), we want pagination so we can keep STORIES_PAGE_SIZE small AND
  # support resume via --start-offset. fetch_stories_list handles that
  # internally. When a filter IS present, the server returns everything in
  # one shot (it ignores offset for filtered queries).
  #
  # For a filtered sweep we set fetch_all=1 but fetch_stories_list short-
  # circuits to a single request. For an unfiltered sweep we honor
  # start_offset on the FIRST sweep only — subsequent sweeps would only
  # exist if active mode were on, which always has a filter.
  local sweep page count
  for sweep in "${sweeps[@]}"; do
    [[ "$active" -eq 1 && "$quiet" -ne 1 ]] && echo "[$project_id]  -> sweep ${sweep}"
    [[ "${LT_DEBUG:-0}" == "1" ]] && printf "[lt-debug] cache sync sweep: filter=%s\n" "${sweep:-<none>}" >&2

    if [[ -z "$sweep" && "$start_offset" -gt 0 ]]; then
      # Resume: paginate manually from start_offset for the first sweep only.
      local cur_offset=$start_offset
      while :; do
        local qs
        qs=$(build_qs "" "$cur_offset" "$STORIES_PAGE_SIZE")
        page=$(api_get "/projects/$project_id/stories${qs}")
        count=$(echo "$page" | jq 'length')
        if [[ "$count" -gt 0 ]]; then
          apply_page_to_cache "$project_id" "$page" "$quiet" "$cur_offset" stories_inserted stories_updated stories_unchanged pages_fetched
        fi
        [[ "$count" -lt "$STORIES_PAGE_SIZE" ]] && break
        cur_offset=$((cur_offset + STORIES_PAGE_SIZE))
      done
      start_offset=0
      continue
    fi

    page=$(fetch_stories_list "/projects/$project_id/stories" "$sweep" 1 "" "")
    count=$(echo "$page" | jq 'length')
    if [[ "$count" -gt 0 ]]; then
      apply_page_to_cache "$project_id" "$page" "$quiet" 0 stories_inserted stories_updated stories_unchanged pages_fetched
    fi
    start_offset=0
  done

  if [[ "$with_descriptions" -eq 1 ]]; then
    descriptions_fetched=$(cache_sync_descriptions "$project_id" "$quiet")
  fi

  if [[ "$with_comments" -eq 1 ]]; then
    comments_fetched=$(cache_sync_comments "$project_id" "$quiet")
  fi

  if [[ "$with_members" -eq 1 ]]; then
    members_fetched=$(cache_sync_members "$project_id" "$quiet")
  fi

  finished_at=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
  cache_db <<SQL
UPDATE projects SET last_synced_at = '$finished_at' WHERE id = $project_id;
INSERT INTO sync_log(project_id, started_at, finished_at, pages_fetched, stories_inserted, stories_updated, stories_unchanged, comments_fetched, descriptions_fetched, status, error)
VALUES ($project_id, '$started_at', '$finished_at', $pages_fetched, $stories_inserted, $stories_updated, $stories_unchanged, $comments_fetched, $descriptions_fetched, '$status', '$error');
SQL

  echo "[$project_id] done: +${stories_inserted} new, ~${stories_updated} updated, =${stories_unchanged} unchanged (pages: $pages_fetched, descriptions: $descriptions_fetched, comments: $comments_fetched, members: $members_fetched)"
}

# Apply one fetched page (any size) of /stories JSON to the cache via
# cache_sync_page and update the named counter variables in-place.
#
# Args: project_id, page_json, quiet, offset_for_log,
#       inserted_var, updated_var, unchanged_var, pages_var
apply_page_to_cache() {
  local project_id="$1" page_json="$2" quiet="$3" off_log="$4"
  local -n _ins=$5 _upd=$6 _unc=$7 _pages=$8
  local counts p_ins p_upd p_unc
  counts=$(cache_sync_page "$project_id" "$page_json")
  p_ins=$(echo "$counts" | awk -F= '/^inserted/  {print $2}')
  p_upd=$(echo "$counts" | awk -F= '/^updated/   {print $2}')
  p_unc=$(echo "$counts" | awk -F= '/^unchanged/ {print $2}')
  _ins=$((_ins + p_ins))
  _upd=$((_upd + p_upd))
  _unc=$((_unc + p_unc))
  _pages=$((_pages + 1))
  [[ "$quiet" -eq 1 ]] || printf "[%s] page (offset %5d) +%d ~%d =%d\n" \
    "$project_id" "$off_log" "$p_ins" "$p_upd" "$p_unc"
}

# Upsert one project row given id, title, and the full /projects list JSON.
cache_upsert_project() {
  local project_id="$1" title="$2" projects_json="$3"
  local tmp
  tmp=$(mktemp)
  echo "$projects_json" | jq --argjson pid "$project_id" '.[] | select(.id == $pid)' > "$tmp"
  cache_db <<SQL
INSERT INTO projects(id, title, data, last_synced_at)
VALUES ($project_id, $(printf "'%s'" "${title//\'/\'\'}"), readfile('$tmp'), COALESCE((SELECT last_synced_at FROM projects WHERE id = $project_id), NULL))
ON CONFLICT(id) DO UPDATE SET title = excluded.title, data = excluded.data;
SQL
  rm -f "$tmp"
}

# Sync one page of /stories JSON into the cache.
# Echoes three lines: inserted=N, updated=N, unchanged=N.
cache_sync_page() {
  local project_id="$1" page_json="$2"
  local tmp
  tmp=$(mktemp)
  echo "$page_json" > "$tmp"

  cache_db <<SQL
BEGIN IMMEDIATE;

CREATE TEMP TABLE incoming(
  id INTEGER PRIMARY KEY,
  title TEXT, story_type TEXT, current_state TEXT, estimate INTEGER, url TEXT,
  created_at TEXT, updated_at TEXT, accepted_at TEXT, data TEXT
);
CREATE TEMP TABLE incoming_labels(story_id INTEGER, label TEXT);
CREATE TEMP TABLE incoming_owners(story_id INTEGER, owner_id INTEGER);

-- OR IGNORE: LT occasionally returns the same story twice inside a single
-- page response (observed on /projects/254/stories offset=0). The temp table
-- has id INTEGER PRIMARY KEY, so without OR IGNORE the whole page transaction
-- aborts with "UNIQUE constraint failed: incoming.id" and the page is lost.
INSERT OR IGNORE INTO incoming(id, title, story_type, current_state, estimate, url, created_at, updated_at, accepted_at, data)
SELECT
  CAST(json_extract(value, '\$.id') AS INTEGER),
  json_extract(value, '\$.title'),
  json_extract(value, '\$.story_type'),
  json_extract(value, '\$.current_state'),
  CAST(json_extract(value, '\$.estimate') AS INTEGER),
  json_extract(value, '\$.url'),
  json_extract(value, '\$.created_at'),
  json_extract(value, '\$.updated_at'),
  json_extract(value, '\$.accepted_at'),
  value
FROM json_each(readfile('$tmp'));

INSERT INTO incoming_labels(story_id, label)
SELECT
  CAST(json_extract(s.value, '\$.id') AS INTEGER),
  json_extract(l.value, '\$.name')
FROM json_each(readfile('$tmp')) s, json_each(s.value, '\$.labels') l
WHERE json_extract(l.value, '\$.name') IS NOT NULL;

INSERT INTO incoming_owners(story_id, owner_id)
SELECT
  CAST(json_extract(s.value, '\$.id') AS INTEGER),
  CAST(json_extract(o.value, '\$.user_id') AS INTEGER)
FROM json_each(readfile('$tmp')) s, json_each(s.value, '\$.owners') o
WHERE json_extract(o.value, '\$.user_id') IS NOT NULL;

CREATE TEMP TABLE diff_new AS
  SELECT i.* FROM incoming i LEFT JOIN stories s ON s.id = i.id WHERE s.id IS NULL;
CREATE TEMP TABLE diff_changed AS
  SELECT i.* FROM incoming i JOIN stories s ON s.id = i.id
   WHERE COALESCE(s.updated_at,'') <> COALESCE(i.updated_at,'');

INSERT INTO stories(id, project_id, title, story_type, current_state, estimate, url, created_at, updated_at, accepted_at, data, cached_at)
SELECT id, $project_id, title, story_type, current_state, estimate, url, created_at, updated_at, accepted_at, data, datetime('now')
FROM diff_new;

UPDATE stories
   SET title         = (SELECT title         FROM diff_changed dc WHERE dc.id = stories.id),
       story_type    = (SELECT story_type    FROM diff_changed dc WHERE dc.id = stories.id),
       current_state = (SELECT current_state FROM diff_changed dc WHERE dc.id = stories.id),
       estimate      = (SELECT estimate      FROM diff_changed dc WHERE dc.id = stories.id),
       url           = (SELECT url           FROM diff_changed dc WHERE dc.id = stories.id),
       updated_at    = (SELECT updated_at    FROM diff_changed dc WHERE dc.id = stories.id),
       accepted_at   = (SELECT accepted_at   FROM diff_changed dc WHERE dc.id = stories.id),
       data          = (SELECT data          FROM diff_changed dc WHERE dc.id = stories.id),
       -- description / comments caches are now stale; clear the marker so
       -- subsequent --with-descriptions / --with-comments re-fetches them.
       description_updated_at = NULL,
       comments_updated_at    = NULL,
       cached_at     = datetime('now')
 WHERE id IN (SELECT id FROM diff_changed);

DELETE FROM story_labels
 WHERE story_id IN (SELECT id FROM diff_new UNION SELECT id FROM diff_changed);
-- OR IGNORE: LT occasionally repeats a label inside a story's labels[] array.
INSERT OR IGNORE INTO story_labels(story_id, label)
SELECT story_id, label FROM incoming_labels
 WHERE story_id IN (SELECT id FROM diff_new UNION SELECT id FROM diff_changed);

DELETE FROM story_owners
 WHERE story_id IN (SELECT id FROM diff_new UNION SELECT id FROM diff_changed);
-- OR IGNORE: LT occasionally repeats an owner inside a story's owners[] array.
INSERT OR IGNORE INTO story_owners(story_id, owner_id)
SELECT story_id, owner_id FROM incoming_owners
 WHERE story_id IN (SELECT id FROM diff_new UNION SELECT id FROM diff_changed);

-- Counts emitted AFTER writes so a rolled-back transaction never lies to
-- the caller about how many rows landed.
.mode list
.headers off
SELECT 'inserted=' || (SELECT COUNT(*) FROM diff_new);
SELECT 'updated='  || (SELECT COUNT(*) FROM diff_changed);
SELECT 'unchanged=' || ((SELECT COUNT(*) FROM incoming) - (SELECT COUNT(*) FROM diff_new) - (SELECT COUNT(*) FROM diff_changed));

COMMIT;
SQL

  rm -f "$tmp"
}

# Re-fetch story descriptions for any story whose description is missing or
# whose cached `description_updated_at` no longer matches the story's
# current `updated_at`. Equality compare — LT returns `updated_at` as a free
# form string, so ordering is unreliable. Echoes the count fetched.
cache_sync_descriptions() {
  local project_id="$1" quiet="$2"
  local ids fetched=0 sid data tmp
  ids=$(cache_db "SELECT id FROM stories WHERE project_id = $project_id AND (description IS NULL OR description_updated_at IS NULL OR description_updated_at <> updated_at) ORDER BY id;")
  [[ -z "$ids" ]] && { echo 0; return; }
  local total
  total=$(echo "$ids" | wc -l)
  [[ "$quiet" -eq 1 ]] || echo "[$project_id] fetching $total story descriptions" >&2
  for sid in $ids; do
    data=$(api_get "/projects/$project_id/stories/$sid")
    tmp=$(mktemp)
    echo "$data" > "$tmp"
    cache_db <<SQL
UPDATE stories
   SET description            = json_extract(readfile('$tmp'), '\$.description'),
       description_updated_at = updated_at
 WHERE id = $sid;
SQL
    rm -f "$tmp"
    fetched=$((fetched + 1))
    if [[ "$quiet" -eq 0 && $((fetched % 50)) -eq 0 ]]; then
      echo "[$project_id] descriptions: $fetched / $total" >&2
    fi
  done
  echo "$fetched"
}

# Re-fetch comments for any story whose cached `comments_updated_at` no
# longer matches the story's current `updated_at`. Equality compare — see
# cache_sync_descriptions for rationale. Echoes the count fetched.
cache_sync_comments() {
  local project_id="$1" quiet="$2"
  local ids fetched=0 sid data tmp
  ids=$(cache_db "SELECT id FROM stories WHERE project_id = $project_id AND (comments_updated_at IS NULL OR comments_updated_at <> updated_at) ORDER BY id;")
  [[ -z "$ids" ]] && { echo 0; return; }
  local total
  total=$(echo "$ids" | wc -l)
  [[ "$quiet" -eq 1 ]] || echo "[$project_id] fetching comments for $total stories" >&2
  for sid in $ids; do
    data=$(api_get "/projects/$project_id/stories/$sid/comments")
    tmp=$(mktemp)
    echo "$data" > "$tmp"
    cache_db <<SQL
BEGIN IMMEDIATE;
DELETE FROM comments WHERE story_id = $sid;
INSERT INTO comments(id, story_id, text, person_id, created_at, updated_at, data)
SELECT
  CAST(json_extract(value, '\$.id') AS INTEGER),
  $sid,
  json_extract(value, '\$.text'),
  CAST(json_extract(value, '\$.person_id') AS INTEGER),
  json_extract(value, '\$.created_at'),
  json_extract(value, '\$.updated_at'),
  value
FROM json_each(readfile('$tmp'));
UPDATE stories SET comments_updated_at = updated_at WHERE id = $sid;
COMMIT;
SQL
    rm -f "$tmp"
    fetched=$((fetched + 1))
    if [[ "$quiet" -eq 0 && $((fetched % 50)) -eq 0 ]]; then
      echo "[$project_id] comments: $fetched / $total" >&2
    fi
  done
  echo "$fetched"
}

# Fetch /projects/{id}/memberships and upsert into people + memberships.
# `people` is global (a person belongs to many projects); `memberships` is the
# per-project join carrying the role. Echoes the count fetched.
cache_sync_members() {
  local project_id="$1" quiet="$2"
  local data tmp count
  data=$(api_get "/projects/$project_id/memberships")
  count=$(echo "$data" | jq 'length')
  [[ "$quiet" -eq 1 ]] || echo "[$project_id] syncing $count memberships" >&2
  tmp=$(mktemp)
  echo "$data" > "$tmp"
  cache_db <<SQL
BEGIN IMMEDIATE;

-- Upsert people globally — refresh name/email/etc. from the latest sweep.
INSERT INTO people(id, name, email, initials, username, data, cached_at)
SELECT
  CAST(json_extract(value, '\$.person.id') AS INTEGER),
  json_extract(value, '\$.person.name'),
  json_extract(value, '\$.person.email'),
  json_extract(value, '\$.person.initials'),
  json_extract(value, '\$.person.username'),
  json_extract(value, '\$.person'),
  datetime('now')
FROM json_each(readfile('$tmp'))
WHERE json_extract(value, '\$.person.id') IS NOT NULL
ON CONFLICT(id) DO UPDATE SET
  name=excluded.name, email=excluded.email, initials=excluded.initials,
  username=excluded.username, data=excluded.data, cached_at=excluded.cached_at;

-- Replace this project's membership rows wholesale so people who left the
-- project are dropped. People rows are kept (other projects may reference them).
DELETE FROM memberships WHERE project_id = $project_id;
INSERT OR IGNORE INTO memberships(id, project_id, person_id, role, data, cached_at)
SELECT
  CAST(json_extract(value, '\$.id') AS INTEGER),
  $project_id,
  CAST(json_extract(value, '\$.person.id') AS INTEGER),
  json_extract(value, '\$.role'),
  value,
  datetime('now')
FROM json_each(readfile('$tmp'))
WHERE json_extract(value, '\$.id') IS NOT NULL;

COMMIT;
SQL
  rm -f "$tmp"
  echo "$count"
}

# Write-through: persist a single full-story JSON into the cache.
# Opt-in by existence: silently no-op if the user has never run `lt cache sync`
# (so non-cache users never touch sqlite3) or if sqlite3 isn't installed. Also
# no-op if the story's project hasn't been cached yet — the FK would reject it
# and we don't want to fabricate a half-populated projects row.
#
# Reuses cache_sync_page for the row + labels + owners. Layers in `description`
# afterward since list-endpoint syncs don't see it and show/update do.
cache_writethrough_story() {
  local project_id="$1" story_json="$2"
  [[ -f "$CACHE_DB" ]] || return 0
  command -v sqlite3 >/dev/null 2>&1 || return 0
  local has_project
  has_project=$(cache_db "SELECT 1 FROM projects WHERE id = $project_id LIMIT 1;" 2>/dev/null) || return 0
  [[ -n "$has_project" ]] || return 0

  local page_json
  page_json=$(jq -nc --argjson s "$story_json" '[$s]') || return 0
  cache_sync_page "$project_id" "$page_json" >/dev/null 2>&1 || return 0

  if [[ "$(echo "$story_json" | jq 'has("description")')" == "true" ]]; then
    local sid tmp
    sid=$(echo "$story_json" | jq -r '.id')
    tmp=$(mktemp)
    echo "$story_json" > "$tmp"
    cache_db <<SQL 2>/dev/null || true
UPDATE stories
   SET description            = json_extract(readfile('$tmp'), '\$.description'),
       description_updated_at = updated_at
 WHERE id = $sid;
SQL
    rm -f "$tmp"
  fi
}

cmd_cache_stories() {
  check_cache_deps
  local project_id="${1:?Usage: lt cache stories <project_id> [flags]  (see 'lt help')}"
  shift
  require_int "$project_id" "project_id"
  local state="" exclude_state="" type="" label="" since="" limit="" offset=""
  local active=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --active)        active=1; shift ;;
      --state)         state="${2:?--state requires a value}"; require_state "$state" "--state"; shift 2 ;;
      --exclude-state) exclude_state="${2:?--exclude-state requires a value}"; require_state "$exclude_state" "--exclude-state"; shift 2 ;;
      --type)          type="${2:?--type requires a value}"; require_story_type "$type" "--type"; shift 2 ;;
      --label)         label="${2:?--label requires a value}"; shift 2 ;;
      --since)         since="${2:?--since requires a value}"; shift 2 ;;
      --limit)         limit="${2:?--limit requires a value}"; require_int "$limit" "--limit"; shift 2 ;;
      --offset)        offset="${2:?--offset requires a value}"; require_int "$offset" "--offset"; shift 2 ;;
      *) die "Unknown flag: $1" ;;
    esac
  done

  if [[ "$active" -eq 1 && -n "$state" ]]; then
    die "--active and --state are mutually exclusive"
  fi

  [[ -f "$CACHE_DB" ]] || die "No cache found. Run 'lt cache sync $project_id' first."

  local where="WHERE s.project_id = $project_id"
  if [[ "$active" -eq 1 ]]; then
    local in_list="" s
    for s in "${ACTIVE_STATES[@]}"; do
      [[ -n "$in_list" ]] && in_list="$in_list,"
      in_list="$in_list$(sql_lit "$s")"
    done
    where="$where AND s.current_state IN ($in_list)"
  fi
  if [[ -n "$state"         ]]; then where="$where AND s.current_state =  $(sql_lit "$state")"; fi
  if [[ -n "$exclude_state" ]]; then where="$where AND s.current_state <> $(sql_lit "$exclude_state")"; fi
  if [[ -n "$type"          ]]; then where="$where AND s.story_type    =  $(sql_lit "$type")";  fi
  if [[ -n "$since"         ]]; then where="$where AND s.updated_at   >=  $(sql_lit "$since")"; fi
  local join=""
  if [[ -n "$label" ]]; then
    join="JOIN story_labels sl ON sl.story_id = s.id AND sl.label = $(sql_lit "$label")"
  fi
  local pagination=""
  if [[ -n "$limit" ]]; then
    pagination="LIMIT $limit"
    [[ -n "$offset" ]] && pagination="$pagination OFFSET $offset"
  fi

  (
    echo -e "ID\tTYPE\tSTATE\tTITLE"
    cache_db <<SQL
.mode tabs
.headers off
SELECT s.id, s.story_type, s.current_state, s.title
FROM stories s
$join
$where
ORDER BY s.id DESC
$pagination;
SQL
  ) | column -ts $'\t'
}

cmd_cache_stats() {
  check_cache_deps
  [[ -f "$CACHE_DB" ]] || die "No cache yet. Run 'lt cache sync <project_id>' first."
  local project_id="${1:-}"
  local where=""
  [[ -n "$project_id" ]] && { require_int "$project_id" "project_id"; where="WHERE p.id = $project_id"; }

  echo "Cache: $CACHE_DB"
  echo
  (
    echo -e "PROJECT\tTITLE\tSTORIES\tLABELS\tMEMBERS\tLAST_SYNCED"
    cache_db <<SQL
.mode tabs
.headers off
SELECT
  p.id,
  COALESCE(p.title, '(unknown)'),
  (SELECT COUNT(*) FROM stories s WHERE s.project_id = p.id),
  (SELECT COUNT(DISTINCT label) FROM story_labels sl JOIN stories s ON s.id = sl.story_id WHERE s.project_id = p.id),
  (SELECT COUNT(*) FROM memberships m WHERE m.project_id = p.id),
  COALESCE(p.last_synced_at, '-')
FROM projects p
$where
ORDER BY p.id;
SQL
  ) | column -ts $'\t'

  echo
  echo "Recent sync runs:"
  (
    echo -e "PROJECT\tFINISHED\tPAGES\t+NEW\t~UPD\t=UNCH\tDESCR\tCOMMENTS\tSTATUS"
    cache_db <<SQL
.mode tabs
.headers off
SELECT project_id, finished_at, pages_fetched, stories_inserted, stories_updated, stories_unchanged, descriptions_fetched, comments_fetched, status
FROM sync_log
${where//p.id/project_id}
ORDER BY id DESC
LIMIT 10;
SQL
  ) | column -ts $'\t'
  echo
  echo "Note: rows reflect each sync — stories deleted in LT after their first sync may persist locally until 'lt cache sync --full'."
}

# List cached members. With a project_id: everyone on that project + their
# role. Without: every distinct person across all cached projects, with a count
# of how many cached projects they belong to.
cmd_cache_members() {
  check_cache_deps
  [[ -f "$CACHE_DB" ]] || die "No cache yet. Run 'lt cache sync <project_id> --with-members' first."
  local project_id="${1:-}"
  if [[ -n "$project_id" ]]; then
    require_int "$project_id" "project_id"
    (
      echo -e "PERSON_ID\tNAME\tINITIALS\tUSERNAME\tEMAIL\tROLE"
      cache_db <<SQL
.mode tabs
.headers off
SELECT pe.id, COALESCE(pe.name,''), COALESCE(pe.initials,''), COALESCE(pe.username,''), COALESCE(pe.email,''), COALESCE(m.role,'')
FROM memberships m JOIN people pe ON pe.id = m.person_id
WHERE m.project_id = $project_id
ORDER BY pe.name;
SQL
    ) | column -ts $'\t'
  else
    (
      echo -e "PERSON_ID\tNAME\tINITIALS\tUSERNAME\tEMAIL\tPROJECTS"
      cache_db <<SQL
.mode tabs
.headers off
SELECT pe.id, COALESCE(pe.name,''), COALESCE(pe.initials,''), COALESCE(pe.username,''), COALESCE(pe.email,''),
       (SELECT COUNT(*) FROM memberships m WHERE m.person_id = pe.id)
FROM people pe
ORDER BY pe.name;
SQL
    ) | column -ts $'\t'
  fi
}

cmd_cache_clear() {
  check_cache_deps
  [[ -f "$CACHE_DB" ]] || die "No cache to clear."
  local project_id="${1:-}"
  if [[ -z "$project_id" ]]; then
    read -rp "Drop the entire cache at $CACHE_DB? [y/N] " ans
    [[ "$ans" =~ ^[Yy]$ ]] || { echo "Aborted."; return; }
    rm -f "$CACHE_DB" "$CACHE_DB-wal" "$CACHE_DB-shm"
    echo "Removed $CACHE_DB"
    return
  fi
  require_int "$project_id" "project_id"
  read -rp "Drop cached rows for project $project_id? [y/N] " ans
  [[ "$ans" =~ ^[Yy]$ ]] || { echo "Aborted."; return; }
  # FK ON DELETE CASCADE doesn't fire here (foreign_keys pragma is per-
  # connection and off on this one), so delete dependent rows explicitly.
  # People rows are global and left intact; other projects may reference them.
  cache_db <<SQL
DELETE FROM sync_log     WHERE project_id = $project_id;
DELETE FROM memberships  WHERE project_id = $project_id;
DELETE FROM stories      WHERE project_id = $project_id;
DELETE FROM projects     WHERE id = $project_id;
SQL
  echo "Cleared project $project_id from cache."
}

# Quote a string as a SQL literal: wrap in single quotes, double any embedded
# single quotes. Only safe for user-provided plain strings (labels, states).
sql_lit() {
  local s="${1//\'/\'\'}"
  printf "'%s'" "$s"
}

